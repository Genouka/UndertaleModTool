<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UndertaleModLib\UndertaleModLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- bsdbg.dll must stay next to the host executable (DllImport("bsdbg")). -->
    <Content Include="native\win-x64\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <!-- External Butterscotch executables live in native/win-<arch>/ so the runner can
         auto-probe them without clashing with the x64 bsdbg binaries. -->
    <Content Include="native\win-x86\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>native\win-x86\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="native\win-arm64\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>native\win-arm64\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <!--
    Rebuild the embedded Butterscotch runner (bsdbg.dll) when its sources or build
    inputs changed. The target is incremental: MSBuild compares the inputs below
    with native/win-x64/bsdbg.dll and skips the (already incremental) CMake build
    when nothing is newer.

    Set -p:BuildButterscotch=false to use the checked-in DLL (e.g. on build agents
    without the Visual C++ workload / CMake / Ninja).
  -->
  <PropertyGroup>
    <BuildButterscotch Condition="'$(BuildButterscotch)' == ''">true</BuildButterscotch>
    <ButterscotchBuildScript>$(MSBuildThisFileDirectory)..\tools\build-bsdbg.ps1</ButterscotchBuildScript>
    <CanBuildButterscotch Condition="'$(OS)' == 'Windows_NT' and Exists('$(ButterscotchBuildScript)')">true</CanBuildButterscotch>
  </PropertyGroup>
  <ItemGroup>
    <ButterscotchBuildInput Include="$(ButterscotchBuildScript)" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\Butterscotch\CMakeLists.txt" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\Butterscotch\src\**\*.c" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\Butterscotch\src\**\*.h" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\Butterscotch\compat\**\*" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\Butterscotch\cmake\**\*" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\Butterscotch\vendor\**\*.c" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\Butterscotch\vendor\**\*.h" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\ButterscotchDbg\include\**\*" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\ButterscotchDbg\src\**\*" />
    <ButterscotchBuildInput Include="$(MSBuildThisFileDirectory)..\ButterscotchDbg\patches\**\*" />
  </ItemGroup>
  <Target Name="BuildButterscotchRuntime"
          BeforeTargets="PrepareForBuild"
          Condition="'$(BuildButterscotch)' == 'true' and '$(CanBuildButterscotch)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'"
          Inputs="@(ButterscotchBuildInput)"
          Outputs="$(MSBuildThisFileDirectory)native\win-x64\bsdbg.dll;$(MSBuildThisFileDirectory)native\win-x64\SDL2.dll">
    <Message Importance="high" Text="Butterscotch sources changed; rebuilding bsdbg.dll (set -p:BuildButterscotch=false to skip)..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ButterscotchBuildScript)&quot; -Configuration Release"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
