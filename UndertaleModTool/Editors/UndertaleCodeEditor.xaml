<local:DataUserControl x:Class="UndertaleModTool.UndertaleCodeEditor"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:local="clr-namespace:UndertaleModTool"
                       xmlns:undertale="clr-namespace:UndertaleModLib.Models;assembly=UndertaleModLib"
                       xmlns:loc="clr-namespace:UndertaleModTool.Localization"
                       mc:Ignorable="d"
                       d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignInstance undertale:UndertaleCode}"
                       DataContextChanged="UserControl_DataContextChanged" Loaded="UndertaleCodeEditor_Loaded" Unloaded="UndertaleCodeEditor_Unloaded">
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static local:UndertaleCodeEditor.Compile}" Executed="Command_Compile" />
        <CommandBinding Command="{x:Static local:UndertaleCodeEditor.OpenFindCommand}" Executed="Command_OpenFind" />
        <CommandBinding Command="{x:Static local:UndertaleCodeEditor.OpenReplaceCommand}" Executed="Command_OpenReplace" />
        <CommandBinding Command="{x:Static local:UndertaleCodeEditor.GoToDefinition}" Executed="Command_GoToDefinition" />
        <CommandBinding Command="{x:Static local:UndertaleCodeEditor.FindReferences}" Executed="Command_FindReferences" />
        <CommandBinding Command="{x:Static local:UndertaleCodeEditor.FindSymbol}" Executed="Command_FindSymbol" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{x:Static local:UndertaleCodeEditor.Compile}"/>
        <KeyBinding Modifiers="Control" Key="F" Command="{x:Static local:UndertaleCodeEditor.OpenFindCommand}"/>
        <KeyBinding Modifiers="Control" Key="H" Command="{x:Static local:UndertaleCodeEditor.OpenReplaceCommand}"/>
        <KeyBinding Key="F12" Command="{x:Static local:UndertaleCodeEditor.GoToDefinition}"/>
        <KeyBinding Modifiers="Shift" Key="F12" Command="{x:Static local:UndertaleCodeEditor.FindReferences}"/>
        <KeyBinding Modifiers="Control" Key="T" Command="{x:Static local:UndertaleCodeEditor.FindSymbol}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="VisibleIfNotNull" nullValue="Collapsed" notNullValue="Visible"/>
    </UserControl.Resources>
    <Grid MaxHeight="{Binding ElementName=DataEditor, Path=ActualHeight}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="3" Text="{loc:Loc Common_Name}"/>
        <local:UndertaleStringReference Grid.Row="0" Grid.Column="1" Margin="3" ObjectReference="{Binding Name}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="3" Text="{loc:Loc Editor_LocalsCount}"/>
        <local:TextBoxDark Grid.Row="1" Grid.Column="1" Margin="3" Text="{Binding LocalsCount}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="3" Text="{loc:Loc Editor_ArgumentsCount}"/>
        <local:TextBoxDark Grid.Row="2" Grid.Column="1" Margin="3" Text="{Binding ArgumentsCount}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="3" Text="{loc:Loc Editor_Offset}"/>
        <local:TextBoxDark Grid.Row="3" Grid.Column="1" Margin="3" Text="{Binding Offset}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="3" Visibility="{Binding ParentEntry, Converter={StaticResource VisibleIfNotNull}}" Text="{loc:Loc Editor_ParentEntry}"/>
        <local:UndertaleObjectReference Grid.Row="4" Grid.Column="1" Margin="3" Visibility="{Binding ParentEntry, Converter={StaticResource VisibleIfNotNull}}" ObjectReference="{Binding ParentEntry}" ObjectType="{x:Type undertale:UndertaleCode}" CanRemove="False" CanChange="False"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="3,1,3,1">
            <CheckBox x:Name="WordWrapCheck" Margin="3,0,12,0" VerticalAlignment="Center"
                      Content="{loc:Loc Editor_WordWrap}" IsChecked="True"
                      Checked="WordWrapCheck_Changed" Unchecked="WordWrapCheck_Changed"/>
            <CheckBox x:Name="ShowWhitespaceCheck" Margin="3,0,12,0" VerticalAlignment="Center"
                      Content="{loc:Loc Editor_ShowWhitespace}" IsChecked="False"
                      Checked="ShowWhitespaceCheck_Changed" Unchecked="ShowWhitespaceCheck_Changed"/>
            <CheckBox x:Name="ShowHoverInfoCheck" Margin="3,0,12,0" VerticalAlignment="Center"
                      Content="{loc:Loc Editor_ShowHoverInfo}" IsChecked="True"
                      Checked="ShowHoverInfoCheck_Changed" Unchecked="ShowHoverInfoCheck_Changed"/>
            <CheckBox x:Name="AutoDiagnosticsCheck" Margin="3,0,12,0" VerticalAlignment="Center"
                      Content="{loc:Loc Editor_ShowAutoDiagnostics}" IsChecked="True"
                      Checked="AutoDiagnosticsCheck_Changed" Unchecked="AutoDiagnosticsCheck_Changed"/>
            <CheckBox x:Name="ArgumentCountCheck" Margin="3,0,12,0" VerticalAlignment="Center"
                      Content="{loc:Loc Editor_ShowArgumentCountCheck}" IsChecked="True"
                      Checked="ArgumentCountCheck_Changed" Unchecked="ArgumentCountCheck_Changed"/>
        </StackPanel>

        <local:TabControlDark x:Name="CodeModeTabs" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" SelectionChanged="TabControl_SelectionChanged">
            <local:TabItemDark Header="{loc:Loc Editor_Decompiled}" x:Name="DecompiledTab">
                <Grid PreviewMouseWheel="Grid_PreviewMouseWheel" PreviewKeyDown="Grid_PreviewKeyDown">
                    <avalonEdit:TextEditor
                        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                        FontFamily="Consolas"
                        Name="DecompiledEditor"
                        IsReadOnly="True"
                        LineNumbersForeground="#DBDBDB"
                        Foreground="#C0C0C0"
                        ShowLineNumbers="True"
                        GotFocus="DecompiledEditor_GotFocus"
                        LostFocus="DecompiledEditor_LostFocus"
                        WordWrap="True"
                        FontSize="10pt"
                        Padding="4"/>
                    <local:EditorSearchReplacePanel x:Name="DecompiledSearchReplacePanel" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </local:TabItemDark>
            <local:TabItemDark Header="{loc:Loc Editor_Disassembly}" x:Name="DisassemblyTab">
                <Grid PreviewMouseWheel="Grid_PreviewMouseWheel" PreviewKeyDown="Grid_PreviewKeyDown">
                    <avalonEdit:TextEditor
                        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                        FontFamily="Consolas"
                        Name="DisassemblyEditor"
                        IsReadOnly="True"
                        Foreground="#C0C0C0"
                        GotFocus="DisassemblyEditor_GotFocus"
                        LostFocus="DisassemblyEditor_LostFocus"
                        WordWrap="True"
                        FontSize="10pt"
                        Padding="4"/>
                    <local:EditorSearchReplacePanel x:Name="DisassemblySearchReplacePanel" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </local:TabItemDark>
        </local:TabControlDark>
        <Border x:Name="ResultsPanel" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,1,0,0" Visibility="Collapsed" MaxHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,2,4,0">
                    <Button x:Name="ResultsCloseButton" DockPanel.Dock="Right" Content="✕" Width="20" Height="20"
                            Margin="6,0,0,0" Click="ResultsCloseButton_Click"
                            ToolTip="{loc:Loc Common_Close}" Focusable="False"/>
                    <TextBlock x:Name="ResultsHeaderText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </DockPanel>
                <ListBox x:Name="ResultsListBox" Grid.Row="1" Margin="4,2,4,4"
                         Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                         Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="ResultsListBox_MouseDoubleClick"
                         SelectionChanged="ResultsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</local:DataUserControl>
