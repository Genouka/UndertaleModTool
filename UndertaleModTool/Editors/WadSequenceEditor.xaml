<local:DataUserControl x:Class="UndertaleModTool.WadSequenceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UndertaleModTool"
             xmlns:wad="clr-namespace:UndertaleModLib.Wad;assembly=UndertaleModLib"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance wad:WadSeqnEntry}">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="3" FontWeight="Bold"/>
            <local:TextBoxDark Grid.Row="0" Grid.Column="1" Margin="3"
                               Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Playback" Margin="3"/>
            <local:TextBoxDark Grid.Row="1" Grid.Column="1" Margin="3" Text="{Binding Playback, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Playback speed" Margin="3"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="3">
                <local:TextBoxDark Width="140" Text="{Binding PlaybackSpeed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <local:TextBoxDark Width="120" Text="{Binding PlaybackSpeedType, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Length" Margin="3"/>
            <local:TextBoxDark Grid.Row="3" Grid.Column="1" Margin="3" Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Origin" Margin="3"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="3">
                <local:TextBoxDark Width="110" Text="{Binding Xorigin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <local:TextBoxDark Width="110" Text="{Binding Yorigin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Volume / size" Margin="3"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="3">
                <local:TextBoxDark Width="90" Text="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <local:TextBoxDark Width="90" Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <local:TextBoxDark Width="90" Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Events" Margin="3"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Margin="3" Text="{Binding Events.Keyframes.Count, Mode=OneWay}"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Tracks" Margin="3"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Margin="3" Text="{Binding Tracks.Tracks.Count, Mode=OneWay}"/>
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Event-to-function" Margin="3"/>
            <TextBlock Grid.Row="8" Grid.Column="1" Margin="3" Text="{Binding EventToFunction.Items.Count, Mode=OneWay}"/>
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Moments" Margin="3"/>
            <TextBlock Grid.Row="9" Grid.Column="1" Margin="3" Text="{Binding Moments.Keyframes.Count, Mode=OneWay}"/>
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Parsed region ends" Margin="3"/>
            <TextBlock Grid.Row="10" Grid.Column="1" Margin="3" Text="{Binding ParseEndOffset, Mode=OneWay, StringFormat='0x{0:X8}'}"/>
        </Grid>
    </DockPanel>
</local:DataUserControl>