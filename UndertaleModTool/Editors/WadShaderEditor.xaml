<local:DataUserControl x:Class="UndertaleModTool.WadShaderEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UndertaleModTool"
             xmlns:wad="clr-namespace:UndertaleModLib.Wad;assembly=UndertaleModLib"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance wad:WadShdrEntry}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="3" FontWeight="Bold"/>
        <local:TextBoxDark Grid.Row="0" Grid.Column="1" Margin="3"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           ToolTip="Shaders can be renamed; the source blobs themselves are fixed-size and stay read-only."/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vertex blob" Margin="3"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="3"><Run Text="{Binding VertexBlobOffset, Mode=OneWay, StringFormat='0x{0:X8}'}"/><Run Text=" — "/><Run Text="{Binding VertexLen, Mode=OneWay}"/><Run Text=" bytes"/></TextBlock>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fragment blob" Margin="3"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="3"><Run Text="{Binding FragmentBlobOffset, Mode=OneWay, StringFormat='0x{0:X8}'}"/><Run Text=" — "/><Run Text="{Binding FragmentLen, Mode=OneWay}"/><Run Text=" bytes"/></TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Metadata A" Margin="3"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Margin="3"><Run Text="{Binding MetaABlobOffset, Mode=OneWay, StringFormat='0x{0:X8}'}"/><Run Text="  scalar: "/><Run Text="{Binding ScalarA, Mode=OneWay}"/></TextBlock>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Metadata B" Margin="3"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Margin="3"><Run Text="{Binding MetaBBlobOffset, Mode=OneWay, StringFormat='0x{0:X8}'}"/><Run Text="  scalar: "/><Run Text="{Binding ScalarB, Mode=OneWay}"/></TextBlock>
    </Grid>
</local:DataUserControl>