<Window x:Class="UndertaleModTool.ContributorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UndertaleModTool.Localization"
        Title="{loc:Loc Contributors_Title}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="{loc:Loc Contributors_Description}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />
        <Button Content="{loc:Loc Contributors_Fork}"
                Tag="https://github.com/Genouka/UndertaleModTool/graphs/contributors?all=1"
                Click="OpenLinkClick"
                Padding="8,4"
                Margin="0,0,0,6"
                HorizontalContentAlignment="Left" />
        <Button Content="{loc:Loc Contributors_Upstream}"
                Tag="https://github.com/QiumingOrg/QiuUTMTv4/graphs/contributors?all=1"
                Click="OpenLinkClick"
                Padding="8,4"
                Margin="0,0,0,6"
                HorizontalContentAlignment="Left" />
        <Button Content="{loc:Loc Contributors_Translators}"
                Tag="https://hosted.weblate.org/engage/qiuutmtv4/"
                Click="OpenLinkClick"
                Padding="8,4"
                Margin="0,0,0,6"
                HorizontalContentAlignment="Left" />
        <Button Content="{loc:Loc Common_OK}"
                IsDefault="True"
                IsCancel="True"
                Width="75"
                HorizontalAlignment="Right"
                Margin="0,12,0,0" />
    </StackPanel>
</Window>
