<Window x:Class="UndertaleModTool.UpdateWindow"
        IsVisibleChanged="Window_IsVisibleChanged"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UndertaleModTool"
        xmlns:loc="clr-namespace:UndertaleModTool.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Msg_UpdateDialogTitle}"
        Width="680" Height="600" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF2563EB" Offset="0"/>
                    <GradientStop Color="#FF7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="46" Height="46" CornerRadius="23" Background="#33FFFFFF"
                        VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,3 L12,16 M6,10 L12,4 L18,10 M4,20 L20,20"
                                  Stroke="White" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText" FontSize="21" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeaderSubtitleText" FontSize="12.5" Foreground="#E6FFFFFF"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="10" Padding="10,3"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="BadgeText" FontSize="11.5" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- Version before/after -->
        <Grid Grid.Row="1" Margin="24,18,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Padding="14,10"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Msg_UpdateDialogCurrentVersion}" FontSize="11"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <TextBlock x:Name="CurrentVersionText" FontSize="18" FontWeight="SemiBold"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1" Text="→" FontSize="22" Margin="12,0"
                       VerticalAlignment="Center" Foreground="#FF3B82F6"/>

            <Border Grid.Column="2" CornerRadius="8" Padding="14,10"
                    Background="#1A3B82F6" BorderBrush="#803B82F6" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Msg_UpdateDialogLatestVersion}" FontSize="11"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <TextBlock x:Name="LatestVersionText" FontSize="18" FontWeight="SemiBold"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Changelog heading -->
        <TextBlock Grid.Row="2" Text="{loc:Loc Msg_UpdateDialogChangelog}"
                   FontSize="14" FontWeight="SemiBold" Margin="24,18,24,8"/>

        <!-- Changelog -->
        <Border Grid.Row="3" Margin="24,0,24,0" CornerRadius="8" Padding="12,8"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <local:TextBoxDark x:Name="ChangelogBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                               BorderThickness="0" Background="Transparent" Padding="0"
                               FontSize="12.5" TextWrapping="Wrap"
                               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                               VerticalContentAlignment="Top"/>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="24,18,24,20">
            <local:ButtonDark Content="{loc:Loc Msg_UpdateDialogLater}" Padding="18,7"
                              MinWidth="90" IsCancel="True" Click="LaterButton_Click"/>
            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                    MinWidth="108" Margin="8,0,0,0" IsDefault="True" Click="UpdateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
