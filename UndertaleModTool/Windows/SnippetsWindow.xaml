<Window x:Class="UndertaleModTool.SnippetsWindow"
        IsVisibleChanged="Window_IsVisibleChanged"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:UndertaleModTool"
        xmlns:loc="clr-namespace:UndertaleModTool.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Sn_Title}" Height="560" Width="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Grid.Row="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <local:ButtonDark Content="{loc:Loc Sn_New}" Click="NewButton_Click" Padding="10,3" Margin="0,0,6,0"/>
                <local:ButtonDark Content="{loc:Loc Sn_Delete}" Click="DeleteButton_Click" Padding="10,3"/>
            </StackPanel>
            <ListBox x:Name="SnippetsList"
                     SelectionChanged="SnippetsList_SelectionChanged"
                     Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                     Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Shortcut}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3" VerticalAlignment="Center" Text="{loc:Loc Sn_Name}"/>
            <local:TextBoxDark Grid.Row="0" Grid.Column="1" Margin="3" x:Name="NameBox"
                               TextChanged="NameBox_TextChanged"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3" VerticalAlignment="Center" Text="{loc:Loc Sn_Shortcut}"/>
            <local:TextBoxDark Grid.Row="1" Grid.Column="1" Margin="3" x:Name="ShortcutBox"
                               TextChanged="ShortcutBox_TextChanged"
                               PreviewKeyDown="ShortcutBox_PreviewKeyDown"/>

            <TextBlock Grid.Row="2" Grid.Column="1" Margin="3,0,3,3" TextWrapping="Wrap" Opacity="0.75"
                       FontSize="11" Text="{loc:Loc Sn_ShortcutHint}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="3" Text="{loc:Loc Sn_Body}"/>
            <local:TextBoxDark Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="3"
                               x:Name="BodyBox" AcceptsReturn="True" TextWrapping="NoWrap"
                               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                               VerticalContentAlignment="Top" FontFamily="Consolas"
                               TextChanged="BodyBox_TextChanged"/>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <local:ButtonDark Content="{loc:Loc Sn_Save}" Click="SaveButton_Click" Padding="16,4" Margin="0,0,8,0"/>
            <local:ButtonDark Content="{loc:Loc Sn_Close}" Click="CloseButton_Click" Padding="16,4"/>
        </StackPanel>
    </Grid>
</Window>