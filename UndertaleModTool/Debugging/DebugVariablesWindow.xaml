<Window x:Class="UndertaleModTool.Debugging.DebugVariablesWindow"
        IsVisibleChanged="Window_IsVisibleChanged"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UndertaleModTool"
        xmlns:loc="clr-namespace:UndertaleModTool.Localization"
        Title="{loc:Loc Debug_Variables_Title}" Height="460" Width="720" WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView x:Name="VariableList" Grid.Row="0"
                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                  Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:Loc Debug_Variables_Scope}" Width="80" DisplayMemberBinding="{Binding Source}"/>
                    <GridViewColumn Header="{loc:Loc Debug_Variables_Name}" Width="220" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="{loc:Loc Debug_Variables_Value}" Width="360" DisplayMemberBinding="{Binding Value}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <local:ButtonDark Content="{loc:Loc Debug_Refresh}" Click="RefreshButton_Click" Padding="14,3"/>
        </StackPanel>
    </Grid>
</Window>
