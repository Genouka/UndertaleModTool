<Window x:Class="UndertaleModTool.Debugging.DebugCallStackWindow"
        IsVisibleChanged="Window_IsVisibleChanged"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UndertaleModTool.Localization"
        Title="{loc:Loc Debug_CallStack_Title}" Height="360" Width="760" WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <ListBox x:Name="FrameList"
                 MouseDoubleClick="FrameList_MouseDoubleClick"
                 Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                 Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                 FontFamily="Consolas">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <TextBlock>
                            <Run Text="{Binding CodeName, Mode=OneWay}"/>
                            <Run Text=" @ 0x"/>
                            <Run Text="{Binding Ip, Mode=OneWay, StringFormat=X}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Opacity="0.7">
                            <Run Text="self="/><Run Text="{Binding SelfId, Mode=OneWay}"/>
                            <Run Text=" event="/><Run Text="{Binding EventType, Mode=OneWay}"/>
                            <Run Text="/"/><Run Text="{Binding EventSubtype, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
