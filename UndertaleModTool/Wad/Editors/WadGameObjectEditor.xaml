<local:DataUserControl x:Class="UndertaleModTool.WadGameObjectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UndertaleModTool"
             xmlns:wad="clr-namespace:UndertaleModLib.Wad;assembly=UndertaleModLib"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance wad:WadObjtEntry}"
             DataContextChanged="WadGameObjectEditor_DataContextChanged">
    <DockPanel Margin="8">
        <!-- Identity / flags -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="3" FontWeight="Bold"/>
            <local:TextBoxDark Grid.Row="0" Grid.Column="1" Margin="3"
                               Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               ToolTip="Renames are stored internally: the new string is appended to the file and the object's reference is repointed on save."/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Parent" Margin="3"/>
            <local:ComboBoxDark x:Name="ParentBox" Grid.Row="1" Grid.Column="1" Margin="3"
                                SelectionChanged="ParentBox_SelectionChanged"
                                ToolTip="Parent object, resolved from the OBJT entry list."/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Persistent" Margin="3"/>
            <CheckBox Grid.Row="2" Grid.Column="1" Margin="3" VerticalAlignment="Center"
                      IsChecked="{Binding Persistent, Mode=TwoWay, UpdateSourceTrigger=Default}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Visible" Margin="3"/>
            <CheckBox Grid.Row="3" Grid.Column="1" Margin="3" VerticalAlignment="Center"
                      IsChecked="{Binding Visible, Mode=TwoWay, UpdateSourceTrigger=Default}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Component section" Margin="3"/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="3" IsReadOnly="True"
                     Text="{Binding ComponentSectionOffset, StringFormat='0x{0:X8}', Mode=OneWay}"/>
        </Grid>

        <Separator Margin="3"/>

        <!-- Events -->
        <TextBlock DockPanel.Dock="Top" Margin="3" FontWeight="Bold" Text="Events"/>
        <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Events}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserAddRows="False" CanUserDeleteRows="False" Margin="3"
                  MaxHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Event number" Width="120" Binding="{Binding EventNum}"/>
                <DataGridTextColumn Header="Event type" Width="120" Binding="{Binding EventType, StringFormat='0x{0:X8}'}"/>
                <DataGridTextColumn Header="Script index" Width="*" Binding="{Binding ScriptIndex}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Components -->
        <TextBlock DockPanel.Dock="Top" Margin="3" FontWeight="Bold" Text="Components"/>
        <DataGrid ItemsSource="{Binding Components}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserAddRows="False" CanUserDeleteRows="False" Margin="3"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Entry" Width="110" Binding="{Binding EntryOffset, StringFormat='0x{0:X8}'}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</local:DataUserControl>