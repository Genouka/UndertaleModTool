<local:DataUserControl x:Class="UndertaleModTool.WadBackgroundEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UndertaleModTool"
             xmlns:wad="clr-namespace:UndertaleModLib.Wad;assembly=UndertaleModLib"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance wad:WadBgndEntry}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="3" FontWeight="Bold"/>
            <local:TextBoxDark Grid.Row="0" Grid.Column="1" Margin="3"
                               Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Transparent" Margin="3"/>
            <CheckBox Grid.Row="1" Grid.Column="1" Margin="3" VerticalAlignment="Center" IsChecked="{Binding Transparent, Mode=TwoWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Smooth" Margin="3"/>
            <CheckBox Grid.Row="2" Grid.Column="1" Margin="3" VerticalAlignment="Center" IsChecked="{Binding Smooth, Mode=TwoWay}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Preload" Margin="3"/>
            <CheckBox Grid.Row="3" Grid.Column="1" Margin="3" VerticalAlignment="Center" IsChecked="{Binding Preload, Mode=TwoWay}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Image (TPAG record)" Margin="3"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Margin="3" Text="{Binding ImageRef, StringFormat='0x{0:X8}'}"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Tile size" Margin="3"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="3">
                <local:TextBoxDark Width="110" Text="{Binding TileWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <local:TextBoxDark Width="110" Text="{Binding TileHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Tile separation" Margin="3"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="3">
                <local:TextBoxDark Width="110" Text="{Binding TileHSep, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <local:TextBoxDark Width="110" Text="{Binding TileVSep, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Tile border" Margin="3"/>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="3">
                <local:TextBoxDark Width="110" Text="{Binding TileBorderX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <local:TextBoxDark Width="110" Text="{Binding TileBorderY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Columns" Margin="3"/>
            <local:TextBoxDark Grid.Row="8" Grid.Column="1" Margin="3" Text="{Binding Columns, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Frames" Margin="3"/>
            <local:TextBoxDark Grid.Row="9" Grid.Column="1" Margin="3" Text="{Binding Frames, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Tile count" Margin="3"/>
            <local:TextBoxDark Grid.Row="10" Grid.Column="1" Margin="3" Text="{Binding TileCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Sprite index" Margin="3"/>
            <local:TextBoxDark Grid.Row="11" Grid.Column="1" Margin="3" Text="{Binding SpriteIndex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="12" Grid.Column="0" Text="Frame length" Margin="3"/>
            <TextBlock Grid.Row="12" Grid.Column="1" Margin="3"><Run Text="{Binding FrameLengthLo, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding FrameLengthHi, Mode=OneWay}"/></TextBlock>
            <TextBlock Grid.Row="13" Grid.Column="0" Text="Frame data" Margin="3"/>
            <TextBlock Grid.Row="13" Grid.Column="1" Margin="3"><Run Text="{Binding FrameData.Count, Mode=OneWay}"/><Run Text="  entries  ("/><Run Text="{Binding UnknownConst, Mode=OneWay, StringFormat='0x{0:X8}'}"/><Run Text=")"/></TextBlock>
            <TextBlock Grid.Row="14" Grid.Column="0" Text="Tail bytes" Margin="3"/>
            <TextBlock Grid.Row="14" Grid.Column="1" Margin="3" Text="{Binding TailBytes.Length}"/>
        </Grid>
    </DockPanel>
    </ScrollViewer>
</local:DataUserControl>