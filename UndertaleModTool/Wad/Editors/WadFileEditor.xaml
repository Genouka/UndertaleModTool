<local:DataUserControl x:Class="UndertaleModTool.WadFileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UndertaleModTool"
             xmlns:wadvm="clr-namespace:UndertaleModTool.Wad"
             xmlns:undertale="clr-namespace:UndertaleModLib.Models;assembly=UndertaleModLib"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance wadvm:WadFileViewModel}"
             DataContextChanged="WadFileEditor_DataContextChanged">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="#555" BorderThickness="0,0,0,1" Padding="4,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open WAD File…" Padding="10,2" Margin="0,0,8,0" Command="{Binding OpenCommand}" ToolTip="Open a GameMaker runtime asset package (*.wad, GMRT 2023+)."/>
                <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding FileInfoText}" VerticalAlignment="Center" Foreground="#999"/>
            </StackPanel>
        </Border>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="4*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Chunk table -->
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Chunks — double-click to open a chunk editor tab"
                       FontWeight="Bold" Margin="2,0,0,4"/>
            <ListView x:Name="ChunkList" Grid.Column="0" Grid.Row="1"
                      ItemsSource="{Binding Chunks}" SelectedItem="{Binding SelectedChunk}"
                      MouseDoubleClick="ChunkList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="66" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Offset" Width="82" DisplayMemberBinding="{Binding OffsetText}"/>
                        <GridViewColumn Header="Length" Width="70" DisplayMemberBinding="{Binding LengthText}"/>
                        <GridViewColumn Header="Entries" Width="64" DisplayMemberBinding="{Binding EntriesCountText}"/>
                        <GridViewColumn Header="Kind" Width="56" DisplayMemberBinding="{Binding KindText}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Entry preview of the selected chunk -->
            <TextBlock Grid.Column="2" Grid.Row="0" Text="Entries" FontWeight="Bold" Margin="2,0,0,4"/>
            <DataGrid Grid.Column="2" Grid.Row="1" ItemsSource="{Binding ChunkEntries}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Width="44" Binding="{Binding Index}"/>
                    <DataGridTextColumn Header="Name" Width="2*" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Summary" Width="3*" Binding="{Binding Summary}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</local:DataUserControl>