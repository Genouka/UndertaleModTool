<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Needed so the simulated windowing platform can implement Avalonia.Platform.IWindowImpl
             and friends (they are only available from the real assemblies when this is enabled). -->
        <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
        <NoWarn>$(NoWarn);AVA3001</NoWarn>
        <Version>0.9.2.0</Version>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <SatelliteResourceLanguages>en;zh-CN</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\UndertaleModTool\Resources\GmlSpecEnglish.gmlspec" Link="GmlSpecEnglish.gmlspec" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\UndertaleModTool\Resources\GmlSpecChinese.gmlspec" Link="GmlSpecChinese.gmlspec" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.6" />
        <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
        <!-- Keep in sync with the 5.3.x pin in UndertaleModLib (Android Mono Volatile.ReadBarrier bug). -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <!-- Managed SDL3 binding only. The native SDL3 packages (SDL3-CS.Linux/Windows/MacOS and
             their Mixer siblings) belong to the heads that run the app:
             UndertaleModToolAvalonia.Desktop references them, the Android head uses
             SDL3-CS.Android instead. Keeping them here leaked desktop natives into the Android
             APK: NuGet's RID graph falls back android-arm64 -> linux-arm64, so
             runtimes/linux-arm64/native/libSDL3.so (glibc, DT_NEEDED libm.so.6) was resolved for
             the android-arm64 target and packed over the AAR's Bionic copy, and the app died in
             JavaSystem.LoadLibrary("SDL3") with "library libm.so.6 not found". -->
        <PackageReference Include="SDL3-CS" Version="3.4.20" />
        <PackageReference Include="TreeDataGrid" Version="12.1.5" />
        <PackageReference Include="Xaml.Behaviors" Version="12.1.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\UndertaleModLib\UndertaleModLib.csproj" />
        <ProjectReference Include="..\UndertaleModRunner\UndertaleModRunner.csproj" />
        <ProjectReference Include="..\UndertaleModToolLocalization\UndertaleModToolLocalization.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <!--
        Avalonia's AvaloniaPrivateApis.targets removes the reference assemblies for the Avalonia
        package after "ResolveTargetingPackAssets", but package references are resolved later, so
        the reference assembly (whose Unstable API members are internal) stays on the compile line
        and prevents implementing ITopLevelImpl etc. Remove them after "ResolvePackageAssets"
        instead; the real (lib) assemblies are then added by AvaloniaPrivateApis.targets.
        -->
        <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    </PropertyGroup>
    <Target Name="RemoveAvaloniaRefAssembliesLate" AfterTargets="ResolvePackageAssets">
        <ItemGroup>
            <Reference Remove="@(Reference)" Condition="'%(Reference.NuGetPackageId)' == 'Avalonia' And '%(Reference.HintPath)' != ''" />
        </ItemGroup>
    </Target>

    <!-- Bundled scripts, shipped next to the app for the Scripts menu and for scripts that use ExePath. -->
    <ItemGroup>
        <None Remove="Scripts\**" />
        <Content Include="Scripts\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
    </ItemGroup>
</Project>
