<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:UndertaleModToolAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UndertaleModToolAvalonia.UndertaleStringReferenceView">
    <ContentControl DataContext="{Binding $parent[l:UndertaleStringReferenceView]}">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <!-- TODO: Make this look/work better -->
            <!-- Editable: a string can be typed (creating it when needed), with the existing strings offered below. -->
            <TextBox Grid.Column="0" Name="ReferenceTextBox"
                     Text="{Binding Reference.Content, Mode=OneWay, TargetNullValue=''}"
                     ToolTip.Tip="{Binding Reference.Content, TargetNullValue={l:Loc RefTooltip_NullStringReference}}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PointerReleased="TextBox_PointerReleased">
                <TextBox.Resources>
                    <l:UndertaleStringDropHandler x:Key="UndertaleStringDropHandler"/>
                </TextBox.Resources>
                <Interaction.Behaviors>
                    <ContextDropBehavior Handler="{StaticResource UndertaleStringDropHandler}"/>
                </Interaction.Behaviors>
            </TextBox>
            
            <Button Grid.Column="1" Command="{Binding Add}"
                    ToolTip.Tip="{l:Loc RefTooltip_AddString}">+</Button>
            
            <Button Grid.Column="2" Command="{Binding Open}"
                    IsEnabled="{Binding Reference, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="{l:Loc RefTooltip_OpenStringCurrentTab}">&gt;</Button>
            
            <Button Grid.Column="3" Command="{Binding OpenInNewTab}"
                    IsEnabled="{Binding Reference, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="{l:Loc RefTooltip_OpenStringNewTab}">&gt;</Button>

            <Popup Grid.Column="0" Grid.ColumnSpan="4" Name="SuggestionsPopup"
                   PlacementTarget="{Binding #ReferenceTextBox}"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True"
                   Width="{Binding #ReferenceTextBox.Bounds.Width}">
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1">
                    <ListBox Name="SuggestionsListBox"
                             MaxHeight="260"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <!-- Keep the keyboard focus in the text box while the dropdown is used. -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
    </ContentControl>
</UserControl>
