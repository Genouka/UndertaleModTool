<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:UndertaleModToolAvalonia"
        mc:Ignorable="d"
        x:Class="UndertaleModToolAvalonia.ProjectAssetsWindow"
        x:DataType="l:ProjectAssetsWindow"
        DataContext="{Binding $self}"
        Title="{l:Loc ProjectAssets_Title}"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,1*">
        <StackPanel Grid.Row="0" Margin="8">
            <Label Content="{l:Loc ProjectAssets_Desc1}"/>
            <Label Content="{l:Loc ProjectAssets_Desc2}"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{x:Null}" Name="AssetsDataGrid" IsReadOnly="True" CanUserResizeColumns="True"
                  DoubleTapped="DataGrid_DoubleTapped"
                  PointerReleased="DataGrid_PointerReleased"
                  Background="Transparent">
            <DataGrid.Resources>
                <l:ProjectAssetsWindowDataGridDropHandler x:Key="ProjectAssetsWindowDataGridDropHandler"/>
            </DataGrid.Resources>
            <Interaction.Behaviors>
                <ContextDropBehavior Handler="{StaticResource ProjectAssetsWindowDataGridDropHandler}"/>
            </Interaction.Behaviors>
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="ContextMenu">
                        <ContextMenu>
                            <MenuItem Header="{l:Loc Common_Open}" Click="DataGridRow_Open_Click"/>
                            <MenuItem Header="{l:Loc Common_OpenInNewTab}" Click="DataGridRow_OpenInNewTab_Click"/>
                            <MenuItem Header="{l:Loc ProjectAssets_UnmarkForExport}" Click="DataGridRow_UnmarkForExport_Click"/>
                        </ContextMenu>
                    </Setter>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Loc Common_Name}" Binding="{ReflectionBinding Name}" Width="Auto" />
                <DataGridTextColumn Header="{l:Loc Common_AssetType}" Binding="{ReflectionBinding AssetType}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
