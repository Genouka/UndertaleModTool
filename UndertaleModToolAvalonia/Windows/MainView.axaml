<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:UndertaleModToolAvalonia"
             xmlns:undertale="clr-namespace:UndertaleModLib;assembly=UndertaleModLib"
             xmlns:undertalem="clr-namespace:UndertaleModLib.Models;assembly=UndertaleModLib"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UndertaleModToolAvalonia.MainView"
             x:DataType="l:MainViewModel"
             Background="Transparent">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <l:MainViewModel />
    </Design.DataContext>

    <Interaction.Behaviors>
        <FilesDropBehavior Command="{Binding OpenDroppedFilesCommand}" />
    </Interaction.Behaviors>

    <DockPanel>
        <l:AppMenuBar DockPanel.Dock="Top" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Name="CommandTextBox" Text="{Binding CommandTextBoxText}" AcceptsReturn="True" />
            <CheckBox Grid.Column="1" Content="{l:Loc Ctrl_MarkedForExport}" IsChecked="{Binding TabIsMarkedForExport}" IsEnabled="{Binding TabCanMarkedForExport}" />
            <Label Grid.Column="2" Content="{Binding TabSelectedResourceIdString}" MinWidth="100" HorizontalContentAlignment="Right"
                   ToolTip.Tip="{l:Loc Ctrl_ObjectID_Tooltip}"/>
        </Grid>

        <!-- The asset explorer (former LeftPanel) lives in a slide-in drawer; the tab area takes
             the full page width while the drawer is closed. Desktop keeps the panel permanently
             visible (push layout, resized with the drag handle) and hides the toggle button;
             Android overlays it (closed by default, with a light-dismiss scrim) to save space. -->
        <l:DrawerPage Name="DrawerPageHost"
                      Mode="{OnPlatform Push, Android=Overlay}"
                      IsCollapsible="{OnPlatform False, Android=True}"
                      IsDrawerOpen="{OnPlatform True, Android=False}">
            <l:DrawerPage.MainContent>
                <Grid RowDefinitions="Auto,1*">
                    <ToggleButton Grid.Row="0"
                                  HorizontalAlignment="Left"
                                  Content="&#x2630;"
                                  FontSize="16"
                                  Padding="10,2"
                                  IsVisible="{Binding #DrawerPageHost.IsCollapsible}"
                                  IsChecked="{Binding #DrawerPageHost.IsDrawerOpen, Mode=TwoWay}"/>
                    <l:TabsView Grid.Row="1" DataContext="{Binding Tabs}" />
                </Grid>
            </l:DrawerPage.MainContent>

            <l:DrawerPage.DrawerContent>
                <Grid RowDefinitions="Auto,1*">
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding Tabs.TabGoBack}" IsEnabled="{Binding Tabs.TabSelected.CanGoBack, FallbackValue=False}">←</Button>
                            <Button Command="{Binding Tabs.TabGoForward}" IsEnabled="{Binding Tabs.TabSelected.CanGoForward, FallbackValue=False}">→</Button>
                        </StackPanel>
                        <Grid ColumnDefinitions="1*,Auto">
                            <TextBox Grid.Column="0" Name="FilterTextBox" PlaceholderText="{l:Loc Ctrl_FilterByName}" Text="{Binding FilterText, Delay=300}"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding IsSorted}" Content="{l:Loc Common_Sort}"/>
                        </Grid>
                    </StackPanel>

                    <l:DataExplorerView Grid.Row="1" Name="DataExplorer" DataContext="{Binding DataExplorer}"/>
                </Grid>
            </l:DrawerPage.DrawerContent>
        </l:DrawerPage>
    </DockPanel>
</UserControl>
