<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:UndertaleModToolAvalonia"
        mc:Ignorable="d"
        x:Class="UndertaleModToolAvalonia.SymbolSearchWindow"
        x:DataType="l:SymbolSearchViewModel"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Header}">
    <DockPanel Margin="8">
        <TextBox x:Name="FilterTextBox" DockPanel.Dock="Top" Watermark="..."/>
        <ListBox x:Name="SymbolsListBox" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                 ItemsSource="{Binding Resources}"
                 SelectedItem="{Binding SelectedResource, Mode=TwoWay}"
                 DoubleTapped="ListBox_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name.Content}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>