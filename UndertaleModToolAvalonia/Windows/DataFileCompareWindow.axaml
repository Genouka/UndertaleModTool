<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:UndertaleModToolAvalonia"
        mc:Ignorable="d"
        x:Class="UndertaleModToolAvalonia.DataFileCompareWindow"
        x:DataType="l:DataFileCompareViewModel"
        Title="Compare Data Files"
        Width="1000"
        Height="520"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,Auto,1*,Auto">
        <Border Grid.Row="0" Padding="10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Grid ColumnDefinitions="1*,Auto,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding BaseLabel}" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding CompareLabel}" TextWrapping="NoWrap" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top"
                        Content="Browse..." Command="{Binding BrowseCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top"
                        Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" MinHeight="4"
                             IsVisible="{Binding IsBusy}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressPercent}" />
            </Grid>
        </Border>

        <Expander Grid.Row="1" Margin="10,6,10,0" Header="Warnings"
                  IsVisible="{Binding HasWarnings}" IsExpanded="False">
            <TextBox Text="{Binding WarningsText}" IsReadOnly="True" AcceptsReturn="True"
                     MaxHeight="120" TextWrapping="Wrap" />
        </Expander>

        <Grid Grid.Row="2" Margin="10" ColumnDefinitions="260,4,*">
            <ListBox Grid.Column="0" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="l:CompareCategoryRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding CountsText}" Margin="8,0,0,0"
                                       Opacity="0.7" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <Grid Grid.Column="2" RowDefinitions="Auto,2*,4,1*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,0,0,6">
                    <TextBox Width="220" Watermark="Filter by name"
                             Text="{Binding FilterText, Delay=250}" />
                    <ComboBox Width="130"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}" />
                    <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} resources'}"
                               VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          IsReadOnly="True" CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal" Margin="8,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="Auto" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeTitle}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="2" ResizeDirection="Rows" />

                <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto,1*" Margin="8,0,0,0">
                    <TextBlock Grid.Row="0" Text="{Binding DetailsTitle}" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="{Binding DetailsNote}" TextWrapping="Wrap"
                               Opacity="0.8" Margin="0,2,0,0" />
                    <ProgressBar Grid.Row="2" MinHeight="3" IsIndeterminate="True"
                                 IsVisible="{Binding IsDetailsBusy}" Margin="0,4,0,0" />

                    <TabControl Grid.Row="3" Margin="0,6,0,0"
                                SelectedIndex="{Binding DetailsTabIndex, Mode=TwoWay}">
                        <TabItem Header="Properties">
                            <DataGrid ItemsSource="{Binding PropertyDiffs}" IsReadOnly="True"
                                      CanUserResizeColumns="True" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Property" Binding="{Binding Path}" Width="2*" />
                                    <DataGridTextColumn Header="Base" Binding="{Binding BaseValue}" Width="*" />
                                    <DataGridTextColumn Header="Compare" Binding="{Binding CompareValue}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="GML diff">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding CodeDiffText}" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Classes="StatusBar" />
    </Grid>
</Window>
