<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UndertaleModToolAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:UndertaleModToolAvalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UndertaleModToolAvalonia.MainWindow"
        Icon="/Assets/Icon.ico"
        x:DataType="l:MainViewModel"
        Title="{Binding Title}"
        WindowState="{Binding WindowState}"
        IsEnabled="{Binding IsEnabled}">
    <!-- The application menu (and the command key bindings derived from it) is built and
         attached to this window by the AppMenuBar control inside MainView. Only tab shortcuts
         that have no menu entry are declared here. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+W', macOS='Meta+W'}" Command="{Binding Tabs.TabCloseSelected}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Shift+W', macOS='Meta+Shift+W'}" Command="{Binding Tabs.TabCloseAll}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Shift+Tab', macOS='Meta+Shift+Tab'}" Command="{Binding Tabs.TabSetToPrevious}" />
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Tab', macOS='Meta+Tab'}" Command="{Binding Tabs.TabSetToNext}" />
    </Window.KeyBindings>

    <l:MainView />
</Window>
