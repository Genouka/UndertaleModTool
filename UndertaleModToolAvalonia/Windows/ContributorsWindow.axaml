<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:UndertaleModToolAvalonia"
        mc:Ignorable="d"
        x:Class="UndertaleModToolAvalonia.ContributorsWindow"
        Title="{l:Loc Contributors_Title}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Classes="MessageWindow">
    <StackPanel Spacing="12" Margin="0,16,0,0">
        <TextBlock Text="{l:Loc Contributors_Description}" TextWrapping="Wrap" />
        <Button Content="{l:Loc Contributors_CodeFork}" Tag="https://github.com/Genouka/UndertaleModTool/graphs/contributors?all=1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OpenLinkClick" />
        <Button Content="{l:Loc Contributors_CodeUpstream}" Tag="https://github.com/QiumingOrg/QiuUTMTv4/graphs/contributors?all=1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OpenLinkClick" />
        <Button Content="{l:Loc Contributors_Translators}" Tag="https://hosted.weblate.org/engage/qiuutmtv4/" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OpenLinkClick" />
        <Button Content="{l:Loc Common_OK}"
                IsDefault="True"
                HorizontalAlignment="Right"
                MinWidth="75"
                Click="CloseClick" />
    </StackPanel>
</Window>
