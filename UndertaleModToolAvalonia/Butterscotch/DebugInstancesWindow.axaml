<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:UndertaleModToolAvalonia"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
        x:Class="UndertaleModToolAvalonia.DebugInstancesWindow"
        x:CompileBindings="False"
        Title="{l:Loc Debug_Instances_Title}" Width="900" Height="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8" RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="2*,8,*">
            <DataGrid x:Name="InstanceGrid" Grid.Column="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserReorderColumns="False" CanUserSortColumns="True"
                      SelectionChanged="InstanceGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Loc Debug_Instances_Id}" Width="80" Binding="{Binding Id}" />
                    <DataGridTextColumn Header="{l:Loc Debug_Instances_Object}" Width="190" Binding="{Binding ObjectName}" />
                    <DataGridTextColumn Header="{l:Loc Debug_Instances_X}" Width="70" Binding="{Binding X}" />
                    <DataGridTextColumn Header="{l:Loc Debug_Instances_Y}" Width="70" Binding="{Binding Y}" />
                    <DataGridTextColumn Header="{l:Loc Debug_Instances_Depth}" Width="70" Binding="{Binding Depth}" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="VariableGrid" Grid.Column="2"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserReorderColumns="False"
                      DoubleTapped="VariableGrid_DoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Loc Debug_Variables_Name}" Width="170" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="{l:Loc Debug_Variables_Value}" Width="*" Binding="{Binding Value}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="{l:Loc Debug_Refresh}" Click="RefreshButton_Click" Padding="14,3" />
        </StackPanel>
    </Grid>
</Window>