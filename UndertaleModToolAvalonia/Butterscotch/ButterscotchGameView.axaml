<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:UndertaleModToolAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UndertaleModToolAvalonia.ButterscotchGameView"
             x:DataType="l:ButterscotchGameViewModel">
    <Grid Background="Black">
        <!-- The native view fills the page; on Android it is a SurfaceView attached to the
             activity's view group by Avalonia's NativeControlHost implementation. -->
        <ContentControl Content="{Binding Surface.View}" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- Debug transport. Portrait: a strip along the bottom edge. Landscape: a column on
             the left edge. The code-behind switches between the two on size changes. -->
        <Border x:Name="DebugBar"
                IsVisible="{Binding ShowDebugPanel}"
                Background="#CC121212" Padding="6" Margin="6" CornerRadius="6"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
            <StackPanel x:Name="DebugActions" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="⏯" Click="OnPauseResume" ToolTip.Tip="Pause / resume" />
                <Button Content="⤵" Click="OnStepInto" ToolTip.Tip="Step into" />
                <Button Content="⤼" Click="OnStepOver" ToolTip.Tip="Step over" />
                <Button Content="⤴" Click="OnStepOut" ToolTip.Tip="Step out" />
                <Button Content="⏭" Click="OnStepFrame" ToolTip.Tip="Next frame" />
                <Button Content="⟳" Click="OnHotReload" ToolTip.Tip="Hot reload" />
                <Button Content="⏹" Click="OnStop" ToolTip.Tip="Stop" />
                <Button Content="⛶" Click="OnToggleFullscreen"
                        IsVisible="{Binding ShowFullscreen}" ToolTip.Tip="Fullscreen" />
                <TextBlock Text="{Binding DebugStatus}" Foreground="#DDDDDD"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Virtual gamepad: a d-pad on the left and A/B on the right, sized to the thumb. -->
        <Grid x:Name="VirtualGamepad" IsVisible="{Binding ShowVirtualGamepad}">
            <Grid ColumnDefinitions="*,Auto,*">
                <Grid Grid.Column="0" Width="160" Height="160"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="12,0,0,24">
                    <Grid.RowDefinitions>1*,1*,1*</Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>1*,1*,1*</Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="1" Tag="{x:Static l:ButterscotchInput.PadUp}"
                            PointerPressed="OnPadPress" PointerReleased="OnPadRelease"
                            Background="#66000000" CornerRadius="8" Margin="1">
                        <TextBlock Text="▲" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Tag="{x:Static l:ButterscotchInput.PadLeft}"
                            PointerPressed="OnPadPress" PointerReleased="OnPadRelease"
                            Background="#66000000" CornerRadius="8" Margin="1">
                        <TextBlock Text="◀" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Tag="{x:Static l:ButterscotchInput.PadRight}"
                            PointerPressed="OnPadPress" PointerReleased="OnPadRelease"
                            Background="#66000000" CornerRadius="8" Margin="1">
                        <TextBlock Text="▶" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Tag="{x:Static l:ButterscotchInput.PadDown}"
                            PointerPressed="OnPadPress" PointerReleased="OnPadRelease"
                            Background="#66000000" CornerRadius="8" Margin="1">
                        <TextBlock Text="▼" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Grid Grid.Column="2" Width="150" Height="120"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,12,24">
                    <Border Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Tag="{x:Static l:ButterscotchInput.PadFace2}"
                            PointerPressed="OnPadPress" PointerReleased="OnPadRelease"
                            Background="#66AA3333" CornerRadius="32">
                        <TextBlock Text="B" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Tag="{x:Static l:ButterscotchInput.PadFace1}"
                            PointerPressed="OnPadPress" PointerReleased="OnPadRelease"
                            Background="#663333AA" CornerRadius="32">
                        <TextBlock Text="A" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Virtual keypad: a compact key bar (Z/X/C/Enter/Esc), top-right so it does not
             cover the bottom-aligned debug strip. -->
        <Border x:Name="VirtualKeypad" IsVisible="{Binding ShowVirtualKeypad}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#CC121212" CornerRadius="6" Padding="6" Margin="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Tag="90" PointerPressed="OnKeyPadPress" PointerReleased="OnKeyPadRelease"
                        Background="#33000000" CornerRadius="4" Width="36" Height="36">
                    <TextBlock Text="Z" Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Border Tag="88" PointerPressed="OnKeyPadPress" PointerReleased="OnKeyPadRelease"
                        Background="#33000000" CornerRadius="4" Width="36" Height="36">
                    <TextBlock Text="X" Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Border Tag="67" PointerPressed="OnKeyPadPress" PointerReleased="OnKeyPadRelease"
                        Background="#33000000" CornerRadius="4" Width="36" Height="36">
                    <TextBlock Text="C" Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Border Tag="13" PointerPressed="OnKeyPadPress" PointerReleased="OnKeyPadRelease"
                        Background="#33000000" CornerRadius="4" Width="52" Height="36">
                    <TextBlock Text="Enter" Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="11" />
                </Border>
                <Border Tag="27" PointerPressed="OnKeyPadPress" PointerReleased="OnKeyPadRelease"
                        Background="#33000000" CornerRadius="4" Width="44" Height="36">
                    <TextBlock Text="Esc" Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="11" />
                </Border>
            </StackPanel>
        </Border>

        <Border IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#99000000" Padding="16" CornerRadius="6"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" Foreground="White" TextWrapping="Wrap" MaxWidth="420" />
        </Border>
    </Grid>
</UserControl>
