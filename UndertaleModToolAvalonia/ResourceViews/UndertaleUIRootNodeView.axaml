<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:UndertaleModToolAvalonia"
             xmlns:undertalem="clr-namespace:UndertaleModLib.Models;assembly=UndertaleModLib"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UndertaleModToolAvalonia.UndertaleUIRootNodeView"
             x:DataType="l:UndertaleUIRootNodeViewModel"
             x:Name="Root">
    <UserControl.Resources>
        <l:EnumTypeToValuesConverter x:Key="EnumTypeToValuesConverter" />
        <l:UndertaleColorToColorConverter x:Key="UndertaleColorToColorConverter" />
    </UserControl.Resources>
    
    <Grid RowDefinitions="Auto,1*" Classes="PaddedProperties">
        <Grid Grid.Row="0" l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
            <Label Content="{l:Loc Common_Name}" />
            <l:UndertaleStringReferenceView Reference="{Binding UIRootNode.Name}" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="1*,Auto,1*">
            <Grid Grid.Row="0" RowDefinitions="1*,Auto">
                <TreeView Grid.Row="0" x:Name="NodesTreeView" ItemsSource="{Binding Nodes}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem /template/ StackPanel > Border#PART_LayoutRoot.TreeViewItemLayoutRoot">
                            <Setter Property="ContextMenu">
                                <ContextMenu>
                                    <MenuItem Header="{l:Loc UI_AddFlexPanel}" Click="ContextMenu_AddFlexPanel_Click"/>
                                    <MenuItem Header="{l:Loc UI_AddGameObject}" Click="ContextMenu_AddGameObject_Click"/>
                                    <MenuItem Header="{l:Loc UI_AddSequenceInstance}" Click="ContextMenu_AddSequenceInstance_Click"/>
                                    <MenuItem Header="{l:Loc UI_AddSpriteInstance}" Click="ContextMenu_AddSpriteInstance_Click"/>
                                    <MenuItem Header="{l:Loc UI_AddTextItemInstance}" Click="ContextMenu_AddTextItemInstance_Click"/>
                                    <MenuItem Header="{l:Loc UI_AddEffectLayer}" Click="ContextMenu_AddEffectLayer_Click"/>
                                    <MenuItem Header="{l:Loc Common_Remove}" Click="ContextMenu_Remove_Click"/>
                                </ContextMenu>
                            </Setter>
                        </Style>
                    </TreeView.Styles>

                    <TreeView.DataTemplates>
                        <l:UINodeTemplateSelector>
                            <!-- This complicated DataType-ing is needed because ItemsSource still has the UndertaleUINode as the DataContext. -->
                            <l:UINodeTemplateSelector.LayerTemplate>
                                <TreeDataTemplate DataType="undertalem:UndertaleUILayer"
                                                  x:DataType="undertalem:UndertaleUINode" ItemsSource="{Binding ((undertalem:UndertaleUILayer)Node).Children}">
                                    <TextBlock x:DataType="undertalem:UndertaleUILayer" Text="{Binding Name.Content}" />
                                </TreeDataTemplate>
                            </l:UINodeTemplateSelector.LayerTemplate>
                            <l:UINodeTemplateSelector.FlexPanelTemplate>
                                <TreeDataTemplate DataType="undertalem:UndertaleUIFlexPanel"
                                                  x:DataType="undertalem:UndertaleUINode" ItemsSource="{Binding ((undertalem:UndertaleUIFlexPanel)Node).Children}">
                                    <TextBlock x:DataType="undertalem:UndertaleUIFlexPanel" Text="{Binding Name.Content}" />
                                </TreeDataTemplate>
                            </l:UINodeTemplateSelector.FlexPanelTemplate>
                            <l:UINodeTemplateSelector.GameObjectTemplate>
                                <TreeDataTemplate DataType="undertalem:UndertaleUIGameObject">
                                    <TextBlock Text="{Binding .}" />
                                </TreeDataTemplate>
                            </l:UINodeTemplateSelector.GameObjectTemplate>
                            <l:UINodeTemplateSelector.SequenceInstanceTemplate>
                                <TreeDataTemplate DataType="undertalem:UndertaleUISequenceInstance">
                                    <TextBlock Text="{Binding .}" />
                                </TreeDataTemplate>
                            </l:UINodeTemplateSelector.SequenceInstanceTemplate>
                            <l:UINodeTemplateSelector.SpriteInstanceTemplate>
                                <TreeDataTemplate DataType="undertalem:UndertaleUISpriteInstance">
                                    <TextBlock Text="{Binding .}" />
                                </TreeDataTemplate>
                            </l:UINodeTemplateSelector.SpriteInstanceTemplate>
                            <l:UINodeTemplateSelector.TextItemInstanceTemplate>
                                <TreeDataTemplate DataType="undertalem:UndertaleUITextItemInstance">
                                    <TextBlock Text="{Binding .}" />
                                </TreeDataTemplate>
                            </l:UINodeTemplateSelector.TextItemInstanceTemplate>
                            <l:UINodeTemplateSelector.EffectLayerTemplate>
                                <TreeDataTemplate DataType="undertalem:UndertaleUIEffectLayer">
                                    <TextBlock Text="{Binding EffectType.Content}" />
                                </TreeDataTemplate>
                            </l:UINodeTemplateSelector.EffectLayerTemplate>
                        </l:UINodeTemplateSelector>
                    </TreeView.DataTemplates>
                </TreeView>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <RepeatButton Click="MoveUp_Click">↑</RepeatButton>
                    <RepeatButton Click="MoveDown_Click" >↓</RepeatButton>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Row="1"/>

            <Grid Grid.Row="2">
                <ScrollViewer>
                    <StackPanel>
                        <ContentControl Content="{Binding #NodesTreeView.((undertalem:UndertaleUINode)SelectedItem).Node}">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="undertalem:UndertaleUILayer">
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
                                        <Label Content="{l:Loc Common_Name}" />
                                        <l:UndertaleStringReferenceView Reference="{Binding Name}" />

                                        <Label Content="{l:Loc UI_DrawSpace}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleUILayer+DrawSpaceKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                    SelectedItem="{Binding DrawSpace}" />

                                        <Label Content="{l:Loc Common_Visible}" />
                                        <CheckBox IsChecked="{Binding Visible}" />
                                    </Grid>
                                </DataTemplate>
                                    
                                <DataTemplate DataType="undertalem:UndertaleUIFlexPanel">
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
                                        <Label Content="{l:Loc Common_Name}" />
                                        <l:UndertaleStringReferenceView Reference="{Binding Name}" />

                                        <Label Content="{l:Loc Common_Width}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Width.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding Width.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc Common_Height}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Height.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding Height.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_MinimumWidth}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding MinimumWidth.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding MinimumWidth.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_MinimumHeight}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding MinimumHeight.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding MinimumHeight.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_MaximumWidth}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding MaximumWidth.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding MaximumWidth.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_MaximumHeight}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding MaximumHeight.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding MaximumHeight.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_OffsetLeft}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding OffsetLeft.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding OffsetLeft.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_OffsetRight}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding OffsetRight.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding OffsetRight.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_OffsetTop}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding OffsetTop.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding OffsetTop.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_OffsetBottom}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding OffsetBottom.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding OffsetBottom.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_ClipsContents}" />
                                        <CheckBox IsChecked="{Binding ClipsContents}" />

                                        <Label Content="{l:Loc UI_PositionType}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleUIFlexPanel+PositionTypeKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                    SelectedItem="{Binding PositionType}" />

                                        <Label Content="{l:Loc UI_AlignSelf}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:IUndertaleFlexProperties+AlignmentKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                    SelectedItem="{Binding AlignSelf}" />

                                        <Label Content="{l:Loc UI_MarginLeft}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding MarginLeft.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding MarginLeft.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_MarginRight}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding MarginRight.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding MarginRight.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_MarginTop}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding MarginTop.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding MarginTop.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_MarginBottom}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding MarginBottom.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding MarginBottom.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_FlexGrow}" />
                                        <TextBox Text="{Binding FlexGrow}" />

                                        <Label Content="{l:Loc UI_FlexShrink}" />
                                        <TextBox Text="{Binding FlexShrink}" />
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate DataType="undertalem:UndertaleUIGameObject">
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
                                        <Label Content="{l:Loc Common_Visible}" />
                                        <CheckBox IsChecked="{Binding Visible}" />

                                        <Label Content="{l:Loc UI_Anchor}" />
                                        <TextBox Text="{Binding Anchor}" />

                                        <Label Content="{l:Loc UI_StretchWidth}" />
                                        <CheckBox IsChecked="{Binding StretchWidth}" />

                                        <Label Content="{l:Loc UI_StretchHeight}" />
                                        <CheckBox IsChecked="{Binding StretchHeight}" />

                                        <Label Content="{l:Loc UI_TileH}" />
                                        <CheckBox IsChecked="{Binding TileH}" />

                                        <Label Content="{l:Loc UI_TileV}" />
                                        <CheckBox IsChecked="{Binding TileV}" />

                                        <Label Content="{l:Loc UI_KeepAspect}" />
                                        <CheckBox IsChecked="{Binding KeepAspect}" />

                                        <!-- Inherited from UndertaleRoom.GameObject - copied from UndertaleRoomView.axaml -->
                                        
                                        <Label Content="{l:Loc UI_PositionXY}" />
                                        <Grid ColumnDefinitions="1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding X}" />
                                            <TextBox Grid.Column="1" Text="{Binding Y}" />
                                        </Grid>

                                        <!-- TODO: Nonexistent? -->
                                        <Label Content="{l:Loc Common_Definition}" />
                                        <l:UndertaleResourceReferenceView Reference="{Binding ObjectDefinition}" ReferenceType="undertalem:UndertaleGameObject" />

                                        <Label Content="{l:Loc Room_InstanceID}" />
                                        <TextBox Text="{Binding InstanceID}" />

                                        <Label Content="{l:Loc Room_CreationCodeLabel}" />
                                        <l:UndertaleResourceReferenceView Reference="{Binding CreationCode}" ReferenceType="undertalem:UndertaleCode" />

                                        <Label Content="{l:Loc UI_ScaleXY}" />
                                        <Grid ColumnDefinitions="1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding ScaleX}" />
                                            <TextBox Grid.Column="1" Text="{Binding ScaleY}" />
                                        </Grid>

                                        <Label Content="{l:Loc Common_Color}" />
                                        <ColorPicker Color="{Binding Color, Converter={StaticResource UndertaleColorToColorConverter}}" />

                                        <Label Content="{l:Loc Common_Rotation}" />
                                        <TextBox Text="{Binding Rotation}" />

                                        <Label Content="{l:Loc Room_FrameIndex}" />
                                        <TextBox Text="{Binding ImageIndex}" />

                                        <Label Content="{l:Loc Room_ImageSpeed}" />
                                        <TextBox Text="{Binding ImageSpeed}" />

                                        <Label Content="{l:Loc Room_PreCreateCode}" />
                                        <l:UndertaleResourceReferenceView Reference="{Binding PreCreateCode}" ReferenceType="undertalem:UndertaleCode" />
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate DataType="undertalem:UndertaleUISequenceInstance">
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
                                        <Label Content="{l:Loc Common_Visible}" />
                                        <CheckBox IsChecked="{Binding Visible}" />

                                        <Label Content="{l:Loc UI_Anchor}" />
                                        <TextBox Text="{Binding Anchor}" />

                                        <Label Content="{l:Loc UI_StretchWidth}" />
                                        <CheckBox IsChecked="{Binding StretchWidth}" />

                                        <Label Content="{l:Loc UI_StretchHeight}" />
                                        <CheckBox IsChecked="{Binding StretchHeight}" />

                                        <Label Content="{l:Loc UI_TileH}" />
                                        <CheckBox IsChecked="{Binding TileH}" />

                                        <Label Content="{l:Loc UI_TileV}" />
                                        <CheckBox IsChecked="{Binding TileV}" />

                                        <Label Content="{l:Loc UI_KeepAspect}" />
                                        <CheckBox IsChecked="{Binding KeepAspect}" />

                                        <!-- Inherited from UndertaleRoom.SequenceInstance - copied from UndertaleRoomView.axaml -->
                                        
                                        <!-- TODO: Add all sequence properties -->
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate DataType="undertalem:UndertaleUISpriteInstance">
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
                                        <Label Content="{l:Loc Common_Visible}" />
                                        <CheckBox IsChecked="{Binding Visible}" />

                                        <Label Content="{l:Loc UI_Anchor}" />
                                        <TextBox Text="{Binding Anchor}" />

                                        <Label Content="{l:Loc UI_StretchWidth}" />
                                        <CheckBox IsChecked="{Binding StretchWidth}" />

                                        <Label Content="{l:Loc UI_StretchHeight}" />
                                        <CheckBox IsChecked="{Binding StretchHeight}" />

                                        <Label Content="{l:Loc UI_TileH}" />
                                        <CheckBox IsChecked="{Binding TileH}" />

                                        <Label Content="{l:Loc UI_TileV}" />
                                        <CheckBox IsChecked="{Binding TileV}" />

                                        <Label Content="{l:Loc UI_KeepAspect}" />
                                        <CheckBox IsChecked="{Binding KeepAspect}" />

                                        <!-- Inherited from UndertaleRoom.SpriteInstance - copied from UndertaleRoomView.axaml -->
                                        
                                        <Label Content="{l:Loc Common_Name}" />
                                        <l:UndertaleStringReferenceView Reference="{Binding Name}" />

                                        <Label Content="{l:Loc Common_Definition}" />
                                        <l:UndertaleResourceReferenceView Reference="{Binding Sprite}" ReferenceType="undertalem:UndertaleSprite"/>

                                        <Label Content="{l:Loc UI_PositionXY}" />
                                        <Grid ColumnDefinitions="1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding X}" />
                                            <TextBox Grid.Column="1" Text="{Binding Y}" />
                                        </Grid>

                                        <Label Content="{l:Loc Common_Scale}" />
                                        <Grid ColumnDefinitions="1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding ScaleX}" />
                                            <TextBox Grid.Column="1" Text="{Binding ScaleY}" />
                                        </Grid>

                                        <Label Content="{l:Loc Common_Color}" />
                                        <ColorPicker Color="{Binding Color, Converter={StaticResource UndertaleColorToColorConverter}}" />

                                        <Label Content="{l:Loc Common_Rotation}" />
                                        <TextBox Text="{Binding Rotation}" />

                                        <Label Content="{l:Loc Room_FrameIndex}" />
                                        <TextBox Text="{Binding FrameIndex}" />

                                        <Label Content="{l:Loc Room_AnimationSpeed}" />
                                        <Grid ColumnDefinitions="1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding AnimationSpeed}" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding Source={x:Type undertalem:AnimationSpeedType}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                      SelectedItem="{Binding AnimationSpeedType}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate DataType="undertalem:UndertaleUITextItemInstance">
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
                                        <Label Content="{l:Loc Common_Visible}" />
                                        <CheckBox IsChecked="{Binding Visible}" />

                                        <Label Content="{l:Loc UI_Anchor}" />
                                        <TextBox Text="{Binding Anchor}" />

                                        <Label Content="{l:Loc UI_StretchWidth}" />
                                        <CheckBox IsChecked="{Binding StretchWidth}" />

                                        <Label Content="{l:Loc UI_StretchHeight}" />
                                        <CheckBox IsChecked="{Binding StretchHeight}" />

                                        <Label Content="{l:Loc UI_TileH}" />
                                        <CheckBox IsChecked="{Binding TileH}" />

                                        <Label Content="{l:Loc UI_TileV}" />
                                        <CheckBox IsChecked="{Binding TileV}" />

                                        <Label Content="{l:Loc UI_KeepAspect}" />
                                        <CheckBox IsChecked="{Binding KeepAspect}" />

                                        <!-- Inherited from UndertaleRoom.TextItemInstance - copied from UndertaleRoomView.axaml -->

                                        <Label Content="{l:Loc Common_Name}" />
                                        <l:UndertaleStringReferenceView Reference="{Binding Name}" />

                                        <Label>X</Label>
                                        <TextBox Text="{Binding X}" />

                                        <Label>Y</Label>
                                        <TextBox Text="{Binding Y}" />

                                        <Label Content="{l:Loc Room_Font}" />
                                        <l:UndertaleResourceReferenceView Reference="{Binding Font}" ReferenceType="undertalem:UndertaleFont" />

                                        <Label Content="{l:Loc Room_ScaleX}" />
                                        <TextBox Text="{Binding ScaleX}" />

                                        <Label Content="{l:Loc Room_ScaleY}" />
                                        <TextBox Text="{Binding ScaleY}" />

                                        <Label Content="{l:Loc Common_Rotation}" />
                                        <TextBox Text="{Binding Rotation}" />

                                        <Label Content="{l:Loc Common_Color}" />
                                        <ColorPicker Color="{Binding Color, Converter={StaticResource UndertaleColorToColorConverter}}" />

                                        <Label Content="{l:Loc Room_OriginX}" />
                                        <TextBox Text="{Binding OriginX}" />

                                        <Label Content="{l:Loc Room_OriginY}" />
                                        <TextBox Text="{Binding OriginY}" />

                                        <Label Content="{l:Loc Room_Text}" />
                                        <l:UndertaleStringReferenceView Reference="{Binding Text}" />

                                        <Label Content="{l:Loc Room_Alignment}" />
                                        <TextBox Text="{Binding Alignment}" />

                                        <Label Content="{l:Loc Room_CharSpacing}" />
                                        <TextBox Text="{Binding CharSpacing}" />

                                        <Label Content="{l:Loc Room_LineSpacing}" />
                                        <TextBox Text="{Binding LineSpacing}" />

                                        <Label Content="{l:Loc Room_FrameWidth}" />
                                        <TextBox Text="{Binding FrameWidth}" />

                                        <Label Content="{l:Loc Room_FrameHeight}" />
                                        <TextBox Text="{Binding FrameHeight}" />

                                        <Label Content="{l:Loc Room_Wrap}" />
                                        <CheckBox IsChecked="{Binding Wrap}" />

                                        <Label Content="{l:Loc Room_ParagraphSpacing}" />
                                        <TextBox Text="{Binding ParagraphSpacing}" />

                                        <Label Content="{l:Loc Room_WrapMode}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleSequence+TextKeyframes+WrapMode}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                  SelectedItem="{Binding WrapMode}" />

                                        <Label Content="{l:Loc Room_Origin}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleSequence+TextKeyframes+Origin}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                  SelectedItem="{Binding Origin}" />
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate DataType="undertalem:UndertaleUIEffectLayer">
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
                                        <Label Content="{l:Loc Common_Enabled}" />
                                        <CheckBox IsChecked="{Binding Enabled}" />

                                        <Label Content="{l:Loc Room_EffectType}" />
                                        <l:UndertaleStringReferenceView Reference="{Binding EffectType}" />

                                        <Label Content="{l:Loc Room_EffectProperties}" />
                                        <l:EditableDataGrid ItemsSource="{Binding Properties}" ItemFactory="{Binding #Root.DataContext.CreateEffectProperty}">
                                            <l:EditableDataGrid.Columns>
                                                <DataGridTemplateColumn Header="{l:Loc Common_Kind}" Width="1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="undertalem:UndertaleRoom+EffectProperty">
                                                            <ComboBox
                                                                ItemsSource="{Binding Source={x:Type undertalem:UndertaleRoom+EffectProperty+PropertyType}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                                SelectedItem="{Binding Kind}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{l:Loc Common_Name}" Width="1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="undertalem:UndertaleRoom+EffectProperty">
                                                            <l:UndertaleStringReferenceView Reference="{Binding Name}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{l:Loc Common_Value}" Width="1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="undertalem:UndertaleRoom+EffectProperty">
                                                            <l:UndertaleStringReferenceView Reference="{Binding Value}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </l:EditableDataGrid.Columns>
                                        </l:EditableDataGrid>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>

                        <ContentControl Content="{Binding #NodesTreeView.((undertalem:UndertaleUINode)SelectedItem).Node}">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="undertalem:UndertaleUIContainer">
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
                                        <Label Content="{l:Loc UI_AlignItems}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:IUndertaleFlexProperties+AlignmentKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                    SelectedItem="{Binding AlignItems}" />

                                        <Label Content="{l:Loc UI_FlexDirection}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:IUndertaleFlexProperties+FlexDirectionKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                    SelectedItem="{Binding FlexDirection}" />

                                        <Label Content="{l:Loc UI_FlexWrap}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:IUndertaleFlexProperties+WrapKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                    SelectedItem="{Binding FlexWrap}" />

                                        <Label Content="{l:Loc UI_AlignContent}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:IUndertaleFlexProperties+AlignmentKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                    SelectedItem="{Binding AlignContent}" />

                                        <Label Content="{l:Loc UI_GapRow}" />
                                        <TextBox Text="{Binding GapRow}" />

                                        <Label Content="{l:Loc UI_GapColumn}" />
                                        <TextBox Text="{Binding GapColumn}" />

                                        <Label Content="{l:Loc UI_PaddingLeft}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding PaddingLeft.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding PaddingLeft.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_PaddingRight}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding PaddingRight.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding PaddingRight.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_PaddingTop}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding PaddingTop.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding PaddingTop.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_PaddingBottom}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding PaddingBottom.Value}" />
                                            <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleFlexValue+UnitKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                        SelectedItem="{Binding PaddingBottom.Unit}" />
                                        </StackPanel>

                                        <Label Content="{l:Loc UI_JustifyContent}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:IUndertaleFlexProperties+JustifyKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                    SelectedItem="{Binding JustifyContent}" />

                                        <Label Content="{l:Loc UI_LayoutDirection}" />
                                        <ComboBox ItemsSource="{Binding Source={x:Type undertalem:IUndertaleFlexProperties+LayoutDirectionKind}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                    SelectedItem="{Binding LayoutDirection}" />
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate DataType="undertalem:IUndertaleUINodeData">
                                    <!-- Empty -->
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
