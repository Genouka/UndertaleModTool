<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:UndertaleModToolAvalonia"
             xmlns:undertalem="clr-namespace:UndertaleModLib.Models;assembly=UndertaleModLib"
             xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UndertaleModToolAvalonia.UndertaleCodeView"
             x:DataType="l:UndertaleCodeViewModel">
    <Grid RowDefinitions="Auto,1*" ColumnDefinitions="1*">
        <Grid Grid.Row="0" ColumnDefinitions="1*,Auto" Classes="PaddedProperties">
            <Grid Grid.Column="0" l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,3*">
                <Label Content="{l:Loc Common_Name}"/>
                <l:UndertaleStringReferenceView Reference="{Binding Code.Name}" />

                <Label Content="{l:Loc Editor_Parent}"/>
                <l:UndertaleResourceReferenceView Reference="{Binding Code.ParentEntry}" ReferenceType="undertalem:UndertaleCode" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Vertical" Classes="HorizontalCenterChildren">
                <Button Command="{Binding CompileAndDecompileCurrent}" ToolTip.Tip="{OnPlatform 'Ctrl+K', macOS='Meta+K'}" Content="{l:Loc Common_CompileAndDecompile}"/>
                <TextBlock IsVisible="{Binding !IsCompiled}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" Text="{l:Loc Common_NotCompiled}"/>
                <TextBlock IsVisible="{Binding IsCompiled}" Text="{l:Loc Common_Compiled}"/>
            </StackPanel>
        </Grid>
        
        <TabControl Grid.Row="1" IsVisible="{Binding Code.ParentEntry, Converter={x:Static ObjectConverters.IsNull}}"
                    SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="{l:Loc Common_GML}">
                <ThemeVariantScope RequestedThemeVariant="Dark">
                    <AvaloniaEdit:TextEditor x:Name="GMLTextEditor"
                                             Document="{Binding GMLTextDocument, Mode=OneWayToSource}"
                                             IsEnabled="{Binding !IsCodeProcessing, Mode=OneWay}"
                                             TextChanged="GMLTextEditor_TextChanged"
                                             ShowLineNumbers="True"
                                             WordWrap="True">
                        <AvaloniaEdit:TextEditor.KeyBindings>
                            <KeyBinding Gesture="{OnPlatform 'Ctrl+K', macOS='Meta+K'}" Command="{Binding CompileAndDecompileGML}" />
                        </AvaloniaEdit:TextEditor.KeyBindings>
                    </AvaloniaEdit:TextEditor>
                </ThemeVariantScope>
            </TabItem>
            <TabItem Header="{l:Loc Common_ASM}">
                <ThemeVariantScope RequestedThemeVariant="Dark">
                    <AvaloniaEdit:TextEditor x:Name="ASMTextEditor"
                                             Document="{Binding ASMTextDocument, Mode=OneWayToSource}"
                                             IsEnabled="{Binding !IsCodeProcessing, Mode=OneWay}"
                                             TextChanged="ASMTextEditor_TextChanged"
                                             ShowLineNumbers="True"
                                             WordWrap="True">
                        <AvaloniaEdit:TextEditor.KeyBindings>
                            <KeyBinding Gesture="{OnPlatform 'Ctrl+K', macOS='Meta+K'}" Command="{Binding CompileAndDecompileASM}" />
                        </AvaloniaEdit:TextEditor.KeyBindings>
                    </AvaloniaEdit:TextEditor>
                </ThemeVariantScope>
            </TabItem>
        </TabControl>
        
        <TextBlock Grid.Row="1" IsVisible="{Binding Code.ParentEntry, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="PaddedProperties">
            <Run Text="{l:Loc Editor_Code_AnonymousFunctionBefore}" /><Run Text="{Binding Code.ParentEntry.Name.Content}"/><Run Text="{l:Loc Editor_Code_AnonymousFunctionAfter}" />
        </TextBlock>
    </Grid>
</UserControl>
