<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:UndertaleModToolAvalonia"
             xmlns:undertale="clr-namespace:UndertaleModLib;assembly=UndertaleModLib"
             xmlns:undertalem="clr-namespace:UndertaleModLib.Models;assembly=UndertaleModLib"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UndertaleModToolAvalonia.UndertaleRoomView"
             x:DataType="l:UndertaleRoomViewModel"
             x:Name="Root">
    <UserControl.Resources>
        <ContextMenu x:Key="GameObjectListMenu">
            <MenuItem Header="{l:Loc Room_AddGameObjectInstance}" Click="ContextMenu_AddGameObjectInstance_GameObjectList_Click"/>
            <MenuItem Header="{l:Loc Room_PasteGameObjectInstance}" Click="ContextMenu_Paste_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="GameObjectMenu">
            <MenuItem Header="{l:Loc Room_CopyGameObjectInstance}" Click="ContextMenu_Copy_Click"/>
            <MenuItem Header="{l:Loc Room_PasteGameObjectInstance}" Click="ContextMenu_Paste_Click"/>
            <MenuItem Header="{l:Loc Room_DeleteGameObjectInstance}" Click="ContextMenu_RemoveGameObjectInstance_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="TileListMenu">
            <MenuItem Header="{l:Loc Room_AddTile}" Click="ContextMenu_AddTile_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="TileMenu">
            <MenuItem Header="{l:Loc Room_DeleteTile}" Click="ContextMenu_RemoveTile_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="LayersListMenu">
            <MenuItem Header="{l:Loc Room_AddBackgroundLayer}" Click="ContextMenu_AddBackgroundLayer_Click"/>
            <MenuItem Header="{l:Loc Room_AddInstancesLayer}" Click="ContextMenu_AddInstancesLayer_Click"/>
            <MenuItem Header="{l:Loc Room_AddTilesLayer}" Click="ContextMenu_AddTilesLayer_Click"/>
            <MenuItem Header="{l:Loc Room_AddPathLayer}" Click="ContextMenu_AddPathLayer_Click"/>
            <MenuItem Header="{l:Loc Room_AddAssetsLayer}" Click="ContextMenu_AddAssetsLayer_Click"/>
            <MenuItem Header="{l:Loc Room_AddEffectLayer}" Click="ContextMenu_AddEffectLayer_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="GenericLayerMenu">
            <MenuItem Header="{l:Loc Room_ToggleVisibility}" Click="ContextMenu_ToggleVisibility_Click"/>
            <MenuItem Header="{l:Loc Room_DeleteLayer}" Click="ContextMenu_RemoveLayer_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="InstancesLayerMenu">
            <MenuItem Header="{l:Loc Room_ToggleVisibility}" Click="ContextMenu_ToggleVisibility_Click"/>
            <MenuItem Header="{l:Loc Room_AddGameObjectInstance}" Click="ContextMenu_AddGameObjectInstance_InstancesLayer_Click"/>
            <MenuItem Header="{l:Loc Room_PasteGameObjectInstance}" Click="ContextMenu_Paste_Click"/>
            <MenuItem Header="{l:Loc Room_DeleteLayer}" Click="ContextMenu_RemoveLayer_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="AssetsLayerMenu">
            <MenuItem Header="{l:Loc Room_ToggleVisibility}" Click="ContextMenu_ToggleVisibility_Click"/>
            <MenuItem Header="{l:Loc Room_AddLegacyTileInstance}" Click="ContextMenu_AddLegacyTileInstance_Click"/>
            <MenuItem Header="{l:Loc Room_AddSpriteInstance}" Click="ContextMenu_AddSpriteInstance_Click"/>
            <MenuItem Header="{l:Loc Room_AddSequenceInstance}" Click="ContextMenu_AddSequenceInstance_Click"/>
            <MenuItem Header="{l:Loc Room_AddParticleSystemInstance}" Click="ContextMenu_AddParticleSystemInstance_Click"/>
            <MenuItem Header="{l:Loc Room_AddTextItemInstance}" Click="ContextMenu_AddTextItemInstance_Click"/>
            <MenuItem Header="{l:Loc Room_DeleteLayer}" Click="ContextMenu_RemoveLayer_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="SpriteInstanceMenu">
            <MenuItem Header="{l:Loc Room_DeleteSpriteInstance}" Click="ContextMenu_RemoveAsset_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="SequenceInstanceMenu">
            <MenuItem Header="{l:Loc Room_DeleteSequenceInstance}" Click="ContextMenu_RemoveAsset_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="ParticleSystemInstanceMenu">
            <MenuItem Header="{l:Loc Room_DeleteParticleSystemInstance}" Click="ContextMenu_RemoveAsset_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="TextItemInstanceMenu">
            <MenuItem Header="{l:Loc Room_DeleteTextItemInstance}" Click="ContextMenu_RemoveAsset_Click"/>
        </ContextMenu>
        <l:LayerAssetsDataToAllAssetsList x:Key="LayerAssetsDataToAllAssetsList" />
        <l:EnumTypeToValuesConverter x:Key="EnumTypeToValuesConverter" />
        <l:UndertaleColorToColorConverter x:Key="UndertaleColorToColorConverter" />
        <l:VersionCompareConverter x:Key="VersionCompareConverter" />
        <l:RoomItemToContextMenuConverter x:Key="RoomItemToContextMenuConverter"
                                          GameObjectListMenu="{StaticResource GameObjectListMenu}"
                                          GameObjectMenu="{StaticResource GameObjectMenu}"
                                          TileListMenu="{StaticResource TileListMenu}"
                                          TileMenu="{StaticResource TileMenu}"
                                          LayersListMenu="{StaticResource LayersListMenu}"
                                          GenericLayerMenu="{StaticResource GenericLayerMenu}"
                                          InstancesLayerMenu="{StaticResource InstancesLayerMenu}"
                                          AssetsLayerMenu="{StaticResource AssetsLayerMenu}"
                                          SpriteInstanceMenu="{StaticResource SpriteInstanceMenu}"
                                          SequenceInstanceMenu="{StaticResource SequenceInstanceMenu}"
                                          ParticleSystemInstanceMenu="{StaticResource ParticleSystemInstanceMenu}"
                                          TextItemInstanceMenu="{StaticResource TextItemInstanceMenu}" />
        <l:ZoomConverter x:Key="ZoomConverter" />
        <l:ZoomLogConverter x:Key="ZoomLogConverter" />
    </UserControl.Resources>
    
    <Grid x:Name="RootGrid" ColumnDefinitions="2*,Auto,5*" RowDefinitions="1*">
        <Grid Grid.Column="0" ColumnDefinitions="1*" RowDefinitions="1*,Auto,1*">
            <Border Grid.Row="0" x:Name="TreeInlineHost">
                <Grid x:Name="TreePanel" RowDefinitions="1*,Auto">
                    <!-- TreeView -->
                    <TreeView Grid.Row="0" Name="RoomItemsTreeView" SelectedItem="{Binding RoomTreeItemsSelectedItem}">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem /template/ StackPanel > Border#PART_LayoutRoot.TreeViewItemLayoutRoot">
                                <Setter Property="ContextMenu" Value="{Binding ., Converter={StaticResource RoomItemToContextMenuConverter}}"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="l:UndertaleRoomViewModel+RoomTreeItem" ItemsSource="{Binding ItemsSource}">
                                <TextBlock Text="{Binding Header}" />
                            </TreeDataTemplate>
                        
                            <DataTemplate DataType="undertalem:UndertaleRoom+Background">
                                <TextBlock Text="{Binding BackgroundDefinition, TargetNullValue={l:Loc Room_BackgroundNotSet}}" Classes.DisableForeground="{Binding !Enabled}"/>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+View">
                                <TextBlock Text="{l:Loc Room_View}" Classes.DisableForeground="{Binding !Enabled}"/>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+GameObject">
                                <TextBlock Text="{Binding .}" />
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+Tile">
                                <TextBlock Text="{Binding .}" />
                            </DataTemplate>
                            
                            <l:LayerTypeTemplateSelector>
                                <l:LayerTypeTemplateSelector.PathTemplate>
                                    <TreeDataTemplate DataType="undertalem:UndertaleRoom+Layer">
                                        <TextBlock Text="{Binding LayerName.Content}" Classes.DisableForeground="{Binding !IsVisible}"/>
                                    </TreeDataTemplate>
                                </l:LayerTypeTemplateSelector.PathTemplate>
                                <l:LayerTypeTemplateSelector.BackgroundTemplate>
                                    <TreeDataTemplate DataType="undertalem:UndertaleRoom+Layer">
                                        <TextBlock Text="{Binding LayerName.Content}" Classes.DisableForeground="{Binding !IsVisible}"/>
                                    </TreeDataTemplate>
                                </l:LayerTypeTemplateSelector.BackgroundTemplate>
                                <l:LayerTypeTemplateSelector.InstancesTemplate>
                                    <TreeDataTemplate DataType="undertalem:UndertaleRoom+Layer" ItemsSource="{Binding InstancesData.Instances}">
                                        <TextBlock Text="{Binding LayerName.Content}" Classes.DisableForeground="{Binding !IsVisible}"/>
                                    </TreeDataTemplate>
                                </l:LayerTypeTemplateSelector.InstancesTemplate>
                                <l:LayerTypeTemplateSelector.AssetsTemplate>
                                    <TreeDataTemplate DataType="undertalem:UndertaleRoom+Layer" ItemsSource="{Binding AssetsData, Converter={StaticResource LayerAssetsDataToAllAssetsList}}">
                                        <TextBlock Text="{Binding LayerName.Content}" Classes.DisableForeground="{Binding !IsVisible}"/>
                                    </TreeDataTemplate>
                                </l:LayerTypeTemplateSelector.AssetsTemplate>
                                <l:LayerTypeTemplateSelector.TilesTemplate>
                                    <TreeDataTemplate DataType="undertalem:UndertaleRoom+Layer">
                                        <TextBlock Text="{Binding LayerName.Content}" Classes.DisableForeground="{Binding !IsVisible}"/>
                                    </TreeDataTemplate>
                                </l:LayerTypeTemplateSelector.TilesTemplate>
                                <l:LayerTypeTemplateSelector.EffectTemplate>
                                    <TreeDataTemplate DataType="undertalem:UndertaleRoom+Layer">
                                        <TextBlock Text="{Binding LayerName.Content}" Classes.DisableForeground="{Binding !IsVisible}"/>
                                    </TreeDataTemplate>
                                </l:LayerTypeTemplateSelector.EffectTemplate>
                            </l:LayerTypeTemplateSelector>
                        
                            <TreeDataTemplate ItemsSource="{Binding .}">
                                <TreeDataTemplate.DataType>
                                    <x:Type TypeName="undertale:UndertalePointerList" x:TypeArguments="undertalem:UndertaleRoom+Tile"/>
                                </TreeDataTemplate.DataType>
                                <TextBlock Text="{l:Loc Room_LegacyTiles}"/>
                            </TreeDataTemplate>
                            <TreeDataTemplate ItemsSource="{Binding .}">
                                <TreeDataTemplate.DataType>
                                    <x:Type TypeName="undertale:UndertalePointerList" x:TypeArguments="undertalem:UndertaleRoom+SpriteInstance"/>
                                </TreeDataTemplate.DataType>
                                <TextBlock Text="{l:Loc Room_Sprites}"/>
                            </TreeDataTemplate>
                            <TreeDataTemplate ItemsSource="{Binding .}">
                                <TreeDataTemplate.DataType>
                                    <x:Type TypeName="undertale:UndertalePointerList" x:TypeArguments="undertalem:UndertaleRoom+SequenceInstance"/>
                                </TreeDataTemplate.DataType>
                                <TextBlock Text="{l:Loc Room_Sequences}"/>
                            </TreeDataTemplate>
                            <TreeDataTemplate ItemsSource="{Binding .}">
                                <TreeDataTemplate.DataType>
                                    <x:Type TypeName="undertale:UndertalePointerList" x:TypeArguments="undertalem:UndertaleRoom+ParticleSystemInstance"/>
                                </TreeDataTemplate.DataType>
                                <TextBlock Text="{l:Loc Room_ParticleSystems}"/>
                            </TreeDataTemplate>
                            <TreeDataTemplate ItemsSource="{Binding .}">
                                <TreeDataTemplate.DataType>
                                    <x:Type TypeName="undertale:UndertalePointerList" x:TypeArguments="undertalem:UndertaleRoom+TextItemInstance"/>
                                </TreeDataTemplate.DataType>
                                <TextBlock Text="{l:Loc Room_TextItems}"/>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    
                        <TreeViewItem x:Name="RoomTreeViewItem" Header="{Binding Room.Name.Content}" IsExpanded="True" ItemsSource="{Binding RoomTreeItems}" />
                    </TreeView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <RepeatButton Click="MoveUp_Click">↑</RepeatButton>
                        <RepeatButton Click="MoveDown_Click" >↓</RepeatButton>
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter Grid.Row="1" />
            <Border Grid.Row="2" x:Name="PropertiesInlineHost">
                <!-- Properties -->
                <ScrollViewer x:Name="PropertiesScroll">
                    <ContentControl Content="{Binding PropertiesContent}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="undertalem:UndertaleRoom">
                                <StackPanel>
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                        <Label Content="{l:Loc Common_Name}"/>
                                        <l:UndertaleStringReferenceView Reference="{Binding Name}" />

                                        <Label Content="{l:Loc Room_Caption}"/>
                                        <l:UndertaleStringReferenceView Reference="{Binding Caption}" />

                                        <Label Content="{l:Loc Room_PortPosSize}"/>
                                        <Grid ColumnDefinitions="1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding Width}" />
                                            <TextBox Grid.Column="1" Text="{Binding Height}" />
                                        </Grid>

                                        <Label Content="{l:Loc Room_Speed}"/>
                                        <TextBox Text="{Binding Speed}" />

                                        <Label Content="{l:Loc Room_Persistent}"/>
                                        <CheckBox IsChecked="{Binding Persistent}" />

                                        <Label Content="{l:Loc Room_BackgroundColor}"/>
                                        <ColorPicker Color="{Binding BackgroundColor, Converter={StaticResource UndertaleColorToColorConverter}}" />

                                        <Label Content="{l:Loc Room_DrawBackgroundColor}"/>
                                        <CheckBox IsChecked="{Binding DrawBackgroundColor}" />

                                        <Label Content="{l:Loc Room_CreationCode}"/>
                                        <l:UndertaleResourceReferenceView Reference="{Binding CreationCodeId}" ReferenceType="undertalem:UndertaleCode" />

                                        <Label Content="{l:Loc Common_Flags}"/>
                                        <l:FlagsBoxView Value="{Binding Flags}" />

                                        <Label Content="{l:Loc Room_World}"/>
                                        <CheckBox IsChecked="{Binding World}" />

                                        <Label Content="{l:Loc Room_TopLeftRightBottom}"/>
                                        <Grid ColumnDefinitions="1*,1*,1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding Top}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Left}"/>
                                            <TextBox Grid.Column="2" Text="{Binding Right}"/>
                                            <TextBox Grid.Column="3" Text="{Binding Bottom}"/>
                                        </Grid>

                                        <Label Content="{l:Loc Room_Gravity}"/>
                                        <Grid ColumnDefinitions="1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding GravityX}"/>
                                            <TextBox Grid.Column="1" Text="{Binding GravityY}"/>
                                        </Grid>

                                        <Label Content="{l:Loc Room_Persistent}"/>
                                        <TextBox Text="{Binding MetersPerPixel}" />
                                    </Grid>

                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*"
                                            IsVisible="{Binding $parent[l:MainView].((l:MainViewModel)DataContext).DataVersion,
                                            Converter={StaticResource VersionCompareConverter},
                                            ConverterParameter=GE2}">
                                        <Label Content="{l:Loc Room_GameObjects}"/>
                                        <l:EditableDataGrid ItemsSource="{Binding GameObjects}" ItemFactory="{x:Null}" HeadersVisibility="None">
                                            <l:EditableDataGrid.Columns>
                                                <DataGridTemplateColumn Header="{l:Loc Room_GameObject}" Width="1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate DataType="undertalem:UndertaleRoom+GameObject">
                                                            <TextBlock Text="{Binding .}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </l:EditableDataGrid.Columns>
                                        </l:EditableDataGrid>
                                    </Grid>

                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*"
                                            IsVisible="{Binding $parent[l:MainView].((l:MainViewModel)DataContext).DataVersion,
                                            Converter={StaticResource VersionCompareConverter},
                                            ConverterParameter=GE2024.13}">
                                        <Label Content="{l:Loc Room_InstanceID}"/>
                                        <l:EditableDataGrid ItemsSource="{Binding InstanceCreationOrderIDs.InstanceIDs}" ItemFactory="{x:Null}" HeadersVisibility="None">
                                            <l:EditableDataGrid.Columns>
                                                <DataGridTemplateColumn Header="{l:Loc Room_IDs}" Width="1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding .}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </l:EditableDataGrid.Columns>
                                        </l:EditableDataGrid>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+Background">
                                <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                    <Label Content="{l:Loc Room_Enabled}"/>
                                    <CheckBox IsChecked="{Binding Enabled}"/>

                                    <Label Content="{l:Loc Room_Foreground}"/>
                                    <CheckBox IsChecked="{Binding Foreground}"/>

                                    <Label Content="{l:Loc Room_Definition}"/>
                                    <l:UndertaleResourceReferenceView Reference="{Binding BackgroundDefinition}" ReferenceType="undertalem:UndertaleBackground" />

                                    <Label Content="{l:Loc Room_Position}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding X}" />
                                        <TextBox Grid.Column="1" Text="{Binding Y}" />
                                    </Grid>

                                    <Label Content="{l:Loc Room_Tiling}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding TiledHorizontally}" Content="{l:Loc Room_Horizontal}" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding TiledVertically}" Content="{l:Loc Room_Vertical}"/>
                                    </Grid>

                                    <Label Content="{l:Loc Room_Speed}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding SpeedX}" />
                                        <TextBox Grid.Column="1" Text="{Binding SpeedY}" />
                                    </Grid>

                                    <Label Content="{l:Loc Room_Stretch}"/>
                                    <CheckBox IsChecked="{Binding Stretch}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+View">
                                <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                    <Label Content="{l:Loc Room_Enabled}"/>
                                    <CheckBox IsChecked="{Binding Enabled}" />

                                    <Label Content="{l:Loc Room_PosSize}"/>
                                    <Grid ColumnDefinitions="1*,1*,1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding ViewX}"/>
                                        <TextBox Grid.Column="1" Text="{Binding ViewY}"/>
                                        <TextBox Grid.Column="2" Text="{Binding ViewWidth}"/>
                                        <TextBox Grid.Column="3" Text="{Binding ViewHeight}"/>
                                    </Grid>

                                    <Label Content="{l:Loc Room_PortPosSize}"/>
                                    <Grid ColumnDefinitions="1*,1*,1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding PortX}"/>
                                        <TextBox Grid.Column="1" Text="{Binding PortY}"/>
                                        <TextBox Grid.Column="2" Text="{Binding PortWidth}"/>
                                        <TextBox Grid.Column="3" Text="{Binding PortHeight}"/>
                                    </Grid>

                                    <Label Content="{l:Loc Room_Border}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding BorderX}"/>
                                        <TextBox Grid.Column="1" Text="{Binding BorderY}"/>
                                    </Grid>

                                    <Label Content="{l:Loc Room_Speed}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding SpeedX}"/>
                                        <TextBox Grid.Column="1" Text="{Binding SpeedY}"/>
                                    </Grid>

                                    <Label Content="{l:Loc Room_FollowsObject}"/>
                                    <l:UndertaleResourceReferenceView Reference="{Binding ObjectId}" ReferenceType="undertalem:UndertaleGameObject" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+GameObject">
                                <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                    <Label Content="{l:Loc Room_Position}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding X}" />
                                        <TextBox Grid.Column="1" Text="{Binding Y}" />
                                    </Grid>

                                    <!-- TODO: Nonexistent? -->
                                    <Label Content="{l:Loc Room_Definition}"/>
                                    <l:UndertaleResourceReferenceView Reference="{Binding ObjectDefinition}" ReferenceType="undertalem:UndertaleGameObject" />

                                    <Label Content="{l:Loc Room_InstanceID}"/>
                                    <TextBox Text="{Binding InstanceID}" />

                                    <Label Content="{l:Loc Room_CreationCode}"/>
                                    <l:UndertaleResourceReferenceView Reference="{Binding CreationCode}" ReferenceType="undertalem:UndertaleCode" />

                                    <Label Content="{l:Loc Editor_ScaleXY}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding ScaleX}" />
                                        <TextBox Grid.Column="1" Text="{Binding ScaleY}" />
                                    </Grid>

                                    <Label Content="{l:Loc Room_Color}"/>
                                    <ColorPicker Color="{Binding Color, Converter={StaticResource UndertaleColorToColorConverter}}" />

                                    <Label Content="{l:Loc Room_Rotation}"/>
                                    <TextBox Text="{Binding Rotation}" />

                                    <Label Content="{l:Loc Room_FrameIndex}"/>
                                    <TextBox Text="{Binding ImageIndex}" />

                                    <Label Content="{l:Loc Room_ImageSpeed}"/>
                                    <TextBox Text="{Binding ImageSpeed}" />

                                    <Label Content="{l:Loc Room_PreCreateCode}"/>
                                    <l:UndertaleResourceReferenceView Reference="{Binding PreCreateCode}" ReferenceType="undertalem:UndertaleCode" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="l:UndertaleRoomViewModel+TilesViewModel">
                                <StackPanel>
                                    <Grid RowDefinitions="Auto,1*"
                                          IsVisible="{Binding $parent[l:MainView].((l:MainViewModel)DataContext).DataVersion,
                                          Converter={StaticResource VersionCompareConverter},
                                          ConverterParameter=L2}">
                                        <l:UndertaleResourceReferenceView
                                            Grid.Row="0"
                                            Reference="{Binding #Root.DataContext.SelectedTileResource}" ReferenceType="undertalem:UndertaleBackground"/>
                                        <l:RoomTilePicker
                                            Grid.Row="1"
                                            SelectedTileBackground="{Binding #Root.DataContext.SelectedTileResource}"
                                            SelectedTileSourceRect="{Binding #Root.DataContext.SelectedTileSourceRect}"
                                            TileWidth="{Binding #Root.DataContext.GridWidth}"
                                            TileHeight="{Binding #Root.DataContext.GridHeight}"/>
                                    </Grid>
                                    
                                    <Grid RowDefinitions="Auto,1*"
                                          IsVisible="{Binding $parent[l:MainView].((l:MainViewModel)DataContext).DataVersion,
                                          Converter={StaticResource VersionCompareConverter},
                                          ConverterParameter=GE2}">
                                        <l:UndertaleResourceReferenceView
                                            Grid.Row="0"
                                            Reference="{Binding #Root.DataContext.SelectedTileResource}" ReferenceType="undertalem:UndertaleSprite"/>
                                        <l:LegacyTilePicker
                                            Grid.Row="1"
                                            SelectedTileSprite="{Binding #Root.DataContext.SelectedTileResource}"
                                            SelectedTileSourceRect="{Binding #Root.DataContext.SelectedTileSourceRect}"
                                            TileWidth="{Binding #Root.DataContext.GridWidth}"
                                            TileHeight="{Binding #Root.DataContext.GridHeight}"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+Tile">
                                <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                    <Label Content="{l:Loc Room_Position}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding X}" />
                                        <TextBox Grid.Column="1" Text="{Binding Y}" />
                                    </Grid>
                                    
                                    <Label Content="{l:Loc Room_Definition}"/>

                                    <Panel>
                                        <Panel IsVisible="{Binding $parent[l:MainView].((l:MainViewModel)DataContext).DataVersion,
                                               Converter={StaticResource VersionCompareConverter},
                                               ConverterParameter=GE2}">
                                            <l:UndertaleResourceReferenceView Reference="{Binding ObjectDefinition}" ReferenceType="undertalem:UndertaleSprite"/>
                                        </Panel>
                                        <Panel IsVisible="{Binding $parent[l:MainView].((l:MainViewModel)DataContext).DataVersion,
                                               Converter={StaticResource VersionCompareConverter},
                                               ConverterParameter=L2}">
                                            <l:UndertaleResourceReferenceView Reference="{Binding ObjectDefinition}" ReferenceType="undertalem:UndertaleBackground"/>
                                        </Panel>
                                    </Panel>

                                    <Label Content="{l:Loc Editor_SourcePositionSize}"/>
                                    <Grid ColumnDefinitions="1*,1*,1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding SourceX}" />
                                        <TextBox Grid.Column="1" Text="{Binding SourceY}" />
                                        <TextBox Grid.Column="2" Text="{Binding Width}" />
                                        <TextBox Grid.Column="3" Text="{Binding Height}" />
                                    </Grid>

                                    <Label Content="{l:Loc Common_Depth}"/>
                                    <TextBox Text="{Binding TileDepth}" />

                                    <Label Content="{l:Loc Room_InstanceID}"/>
                                    <TextBox Text="{Binding InstanceID}" />

                                    <Label Content="{l:Loc Editor_ScaleXY}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding ScaleX}" />
                                        <TextBox Grid.Column="1" Text="{Binding ScaleY}" />
                                    </Grid>

                                    <Label Content="{l:Loc Room_Color}"/>
                                    <ColorPicker Color="{Binding Color, Converter={StaticResource UndertaleColorToColorConverter}}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+Layer">
                                <StackPanel Name="Layer">
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                        <Label Content="{l:Loc Room_LayerType}"/>
                                        <TextBlock Text="{Binding LayerType}" FontWeight="Bold" VerticalAlignment="Center" />
                                        
                                        <Label Content="{l:Loc Room_LayerName}"/>
                                        <l:UndertaleStringReferenceView Reference="{Binding LayerName}" />

                                        <Label Content="{l:Loc Room_LayerId}"/>
                                        <TextBox Text="{Binding LayerId}" />

                                        <Label Content="{l:Loc Common_Depth}"/>
                                        <TextBox Text="{Binding LayerDepth}" />

                                        <Label Content="{l:Loc Room_Visible}"/>
                                        <CheckBox IsChecked="{Binding IsVisible}" />
                                    </Grid>

                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*"
                                          IsVisible="{Binding $parent[l:MainView].((l:MainViewModel)DataContext).DataVersion,
                                          Converter={StaticResource VersionCompareConverter},
                                          ConverterParameter=GE2022.1}">
                                        <Label Content="{l:Loc Room_EffectEnabled}"/>
                                        <CheckBox IsChecked="{Binding EffectEnabled}" />

                                        <Label Content="{l:Loc Room_EffectType}"/>
                                        <l:UndertaleStringReferenceView Reference="{Binding EffectType}" />

                                        <Label Content="{l:Loc Room_EffectProperties}"/>
                                        <l:EditableDataGrid ItemsSource="{Binding EffectProperties}" ItemFactory="{Binding #Root.DataContext.CreateEffectProperty}">
                                            <l:EditableDataGrid.Columns>
                                                <DataGridTemplateColumn Header="{l:Loc Common_Kind}" Width="1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="undertalem:UndertaleRoom+EffectProperty">
                                                            <ComboBox
                                                                ItemsSource="{Binding Source={x:Type undertalem:UndertaleRoom+EffectProperty+PropertyType}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                                SelectedItem="{Binding Kind}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{l:Loc Common_Name}" Width="1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="undertalem:UndertaleRoom+EffectProperty">
                                                            <l:UndertaleStringReferenceView Reference="{Binding Name}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{l:Loc Common_Value}" Width="1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="undertalem:UndertaleRoom+EffectProperty">
                                                            <l:UndertaleStringReferenceView Reference="{Binding Value}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </l:EditableDataGrid.Columns>
                                        </l:EditableDataGrid>
                                    </Grid>
                                
                                    <!-- TODO: Properties for all types of layers -->
                                    <!-- TODO: Don't use ReflectionBinding. But {Binding #Layer.((undertalem:UndertaleRoom+Layer)DataContext).XOffset} doesn't work -->
                                    <ContentControl Content="{Binding Data}">
                                        <ContentControl.DataTemplates>
                                            <DataTemplate DataType="undertalem:UndertaleRoom+Layer+LayerBackgroundData">
                                                <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                                    <Label Content="{l:Loc Room_Offset}"/>
                                                    <Grid ColumnDefinitions="1*,1*">
                                                        <TextBox Grid.Column="0" Text="{ReflectionBinding #Layer.DataContext.XOffset}" />
                                                        <TextBox Grid.Column="1" Text="{ReflectionBinding #Layer.DataContext.YOffset}" />
                                                    </Grid>

                                                    <Label Content="{l:Loc Room_Speed}"/>
                                                    <Grid ColumnDefinitions="1*,1*">
                                                        <TextBox Grid.Column="0" Text="{ReflectionBinding #Layer.DataContext.HSpeed}" />
                                                        <TextBox Grid.Column="1" Text="{ReflectionBinding #Layer.DataContext.VSpeed}" />
                                                    </Grid>

                                                    <Label Content="{l:Loc Room_Visible}"/>
                                                    <CheckBox IsChecked="{Binding Visible}" />

                                                    <Label Content="{l:Loc Room_Foreground}"/>
                                                    <CheckBox IsChecked="{Binding Foreground}" />
                                                    
                                                    <Label Content="{l:Loc Editor_Sprite}"/>
                                                    <l:UndertaleResourceReferenceView Reference="{Binding Sprite}" ReferenceType="undertalem:UndertaleSprite" />

                                                    <Label Content="{l:Loc Room_Tiling}"/>
                                                    <Grid ColumnDefinitions="1*,1*">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding TiledHorizontally}" Content="{l:Loc Room_Horizontal}" />
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding TiledVertically}" Content="{l:Loc Room_Vertical}" />
                                                    </Grid>

                                                    <Label Content="{l:Loc Room_Stretch}"/>
                                                    <CheckBox IsChecked="{Binding Stretch}" />

                                                    <Label Content="{l:Loc Room_Color}"/>
                                                    <ColorPicker Color="{Binding Color, Converter={StaticResource UndertaleColorToColorConverter}}" />

                                                    <Label Content="{l:Loc Room_FirstFrame}"/>
                                                    <TextBox Text="{Binding FirstFrame}" />

                                                    <Label Content="{l:Loc Room_AnimationSpeed}"/>
                                                    <Grid ColumnDefinitions="1*,1*">
                                                        <TextBox Grid.Column="0" Text="{Binding AnimationSpeed}" />
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding Source={x:Type undertalem:AnimationSpeedType}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                                  SelectedItem="{Binding AnimationSpeedType}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate DataType="undertalem:UndertaleRoom+Layer+LayerInstancesData">
                                                <TextBlock Text="{l:Loc Room_ContainsInstances}" />
                                            </DataTemplate>
                                            <DataTemplate DataType="undertalem:UndertaleRoom+Layer+LayerTilesData">
                                                <StackPanel>
                                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                                        <Label Content="{l:Loc Room_Offset}"/>
                                                        <Grid ColumnDefinitions="1*,1*">
                                                            <TextBox Grid.Column="0" Text="{ReflectionBinding #Layer.DataContext.XOffset}" />
                                                            <TextBox Grid.Column="1" Text="{ReflectionBinding #Layer.DataContext.YOffset}" />
                                                        </Grid>

                                                        <Label Content="{l:Loc Room_Speed}"/>
                                                        <Grid ColumnDefinitions="1*,1*">
                                                            <TextBox Grid.Column="0" Text="{ReflectionBinding #Layer.DataContext.HSpeed}" />
                                                            <TextBox Grid.Column="1" Text="{ReflectionBinding #Layer.DataContext.VSpeed}" />
                                                        </Grid>

                                                        <Label Content="{l:Loc Room_Size}"/>
                                                        <Grid ColumnDefinitions="1*,1*,1*">
                                                            <TextBox Grid.Column="0" Text="{Binding TilesX, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBox Grid.Column="1" Text="{Binding TilesY, UpdateSourceTrigger=LostFocus}" />
                                                            <Button Grid.Column="2" Command="{Binding #Root.DataContext.AutoSizeTileLayer}">Auto</Button>
                                                        </Grid>

                                                        <Label Content="{l:Loc Room_TileSet}"/>
                                                        <l:UndertaleResourceReferenceView Reference="{Binding Background}" ReferenceType="undertalem:UndertaleBackground" />
                                                    
                                                        <!-- TODO: Export/import tile data -->

                                                        <Label Content="{l:Loc Room_TileSetColumns}"/>
                                                        <NumericUpDown
                                                            Value="{Binding #Root.DataContext.TileSetColumns}"
                                                            Minimum="0" FormatString="0" />
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Command="{Binding #Root.DataContext.SelectedTileDataFlipX}" HotKey="X">Mirror (X)</Button>
                                                        <Button Command="{Binding #Root.DataContext.SelectedTileDataFlipY}" HotKey="Y">Flip (Y)</Button>
                                                        <Button Command="{Binding #Root.DataContext.SelectedTileDataRotateClockwise}" HotKey="Z">Rotate (Z)</Button>
                                                    </StackPanel>

                                                    <l:LayerTilePicker
                                                        SelectedTileData="{Binding #Root.DataContext.SelectedTileData}"
                                                        TileSetColumns="{Binding #Root.DataContext.TileSetColumns}"
                                                        MinHeight="{Binding $parent[ScrollViewer].Viewport.Height}" />
                                                </StackPanel>
                                            </DataTemplate>
                                            <!--
                                            <DataTemplate DataType="undertalem:UndertaleRoom+Layer+LayerPathData">
                                                <TextBlock Text="{l:Loc Room_Path}" />
                                            </DataTemplate>
                                            -->
                                            <DataTemplate DataType="undertalem:UndertaleRoom+Layer+LayerAssetsData">
                                                <StackPanel>
                                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                                        <Label Content="{l:Loc Room_Offset}"/>
                                                        <Grid ColumnDefinitions="1*,1*">
                                                            <TextBox Grid.Column="0" Text="{ReflectionBinding #Layer.DataContext.XOffset}" />
                                                            <TextBox Grid.Column="1" Text="{ReflectionBinding #Layer.DataContext.YOffset}" />
                                                        </Grid>

                                                        <Label Content="{l:Loc Room_Speed}"/>
                                                        <Grid ColumnDefinitions="1*,1*">
                                                            <TextBox Grid.Column="0" Text="{ReflectionBinding #Layer.DataContext.HSpeed}" />
                                                            <TextBox Grid.Column="1" Text="{ReflectionBinding #Layer.DataContext.VSpeed}" />
                                                        </Grid>
                                                    </Grid>

                                                    <TextBlock Text="{l:Loc Room_ContainsAssets}" />
                                                </StackPanel>
                                            </DataTemplate>
                                            
                                            <DataTemplate DataType="undertalem:UndertaleRoom+Layer+LayerEffectData">
                                                <StackPanel>
                                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                                        <Label Content="{l:Loc Room_EffectType}"/>
                                                        <l:UndertaleStringReferenceView Reference="{ReflectionBinding #Layer.DataContext.EffectType}" />

                                                        <Label Content="{l:Loc Room_Properties}"/>
                                                        <l:EditableDataGrid ItemsSource="{ReflectionBinding #Layer.DataContext.Properties}" ItemFactory="{Binding #Root.DataContext.CreateEffectProperty}">
                                                            <l:EditableDataGrid.Columns>
                                                                <DataGridTemplateColumn Header="{l:Loc Common_Kind}" Width="Auto">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate x:DataType="undertalem:UndertaleRoom+EffectProperty">
                                                                            <ComboBox
                                                                                ItemsSource="{Binding Source={x:Type undertalem:UndertaleRoom+EffectProperty+PropertyType}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                                                SelectedItem="{Binding Kind}" />
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTemplateColumn Header="{l:Loc Common_Name}" Width="Auto">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate x:DataType="undertalem:UndertaleRoom+EffectProperty">
                                                                            <l:UndertaleStringReferenceView Reference="{Binding Name}" />
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTemplateColumn Header="{l:Loc Common_Value}" Width="Auto">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate x:DataType="undertalem:UndertaleRoom+EffectProperty">
                                                                            <l:UndertaleStringReferenceView Reference="{Binding Value}" />
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                            </l:EditableDataGrid.Columns>
                                                        </l:EditableDataGrid>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.DataTemplates>
                                    </ContentControl>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+SpriteInstance">
                                <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                    <Label Content="{l:Loc Common_Name}"/>
                                    <l:UndertaleStringReferenceView Reference="{Binding Name}" />
                                    
                                    <Label Content="{l:Loc Room_Definition}"/>
                                    <l:UndertaleResourceReferenceView Reference="{Binding Sprite}" ReferenceType="undertalem:UndertaleSprite"/>

                                    <Label Content="{l:Loc Room_Position}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding X}" />
                                        <TextBox Grid.Column="1" Text="{Binding Y}" />
                                    </Grid>

                                    <Label Content="{l:Loc Room_Scale}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding ScaleX}" />
                                        <TextBox Grid.Column="1" Text="{Binding ScaleY}" />
                                    </Grid>

                                    <Label Content="{l:Loc Room_Color}"/>
                                    <ColorPicker Color="{Binding Color, Converter={StaticResource UndertaleColorToColorConverter}}" />

                                    <Label Content="{l:Loc Room_Rotation}"/>
                                    <TextBox Text="{Binding Rotation}" />

                                    <Label Content="{l:Loc Room_FrameIndex}"/>
                                    <TextBox Text="{Binding FrameIndex}" />
                                    
                                    <Label Content="{l:Loc Room_AnimationSpeed}"/>
                                    <Grid ColumnDefinitions="1*,1*">
                                        <TextBox Grid.Column="0" Text="{Binding AnimationSpeed}" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Source={x:Type undertalem:AnimationSpeedType}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                                  SelectedItem="{Binding AnimationSpeedType}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+SequenceInstance">
                                <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                    <Label Content="{l:Loc Common_Name}"/>
                                    <l:UndertaleStringReferenceView Reference="{Binding Name}" />

                                    <!-- TODO: Add all sequence properties -->
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+ParticleSystemInstance">
                                <StackPanel>
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                        <Label Content="{l:Loc Common_Name}"/>
                                        <l:UndertaleStringReferenceView Reference="{Binding Name}" />

                                        <Label Content="{l:Loc Room_Definition}"/>
                                        <l:UndertaleResourceReferenceView Reference="{Binding ParticleSystem}" ReferenceType="undertalem:UndertaleParticleSystem"/>

                                        <Label Content="{l:Loc Room_Position}"/>
                                        <Grid ColumnDefinitions="1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding X}" />
                                            <TextBox Grid.Column="1" Text="{Binding Y}" />
                                        </Grid>
                                    
                                        <Label Content="{l:Loc Room_Scale}"/>
                                        <Grid ColumnDefinitions="1*,1*">
                                            <TextBox Grid.Column="0" Text="{Binding ScaleX}" />
                                            <TextBox Grid.Column="1" Text="{Binding ScaleY}" />
                                        </Grid>

                                        <Label Content="{l:Loc Room_Color}"/>
                                        <ColorPicker Color="{Binding Color, Converter={StaticResource UndertaleColorToColorConverter}}" />

                                        <Label Content="{l:Loc Room_Rotation}"/>
                                        <TextBox Text="{Binding Rotation}" />
                                    </Grid>
                                    
                                    <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*"
                                          IsVisible="{Binding $parent[l:MainView].((l:MainViewModel)DataContext).DataVersion,
                                          Converter={StaticResource VersionCompareConverter},
                                          ConverterParameter=GE2024.14}">
                                        <Label Content="{l:Loc Room_InstanceID}"/>
                                        <TextBox Text="{Binding InstanceID}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="undertalem:UndertaleRoom+TextItemInstance">
                                <Grid l:AutoGridBehavior.Enable="True" ColumnDefinitions="1*,2*">
                                    <Label Content="{l:Loc Common_Name}"/>
                                    <l:UndertaleStringReferenceView Reference="{Binding Name}" />

                                    <Label Content="{l:Loc Room_X}"/>
                                    <TextBox Text="{Binding X}" />

                                    <Label Content="{l:Loc Room_Y}"/>
                                    <TextBox Text="{Binding Y}" />

                                    <Label Content="{l:Loc Room_Font}"/>
                                    <l:UndertaleResourceReferenceView Reference="{Binding Font}" ReferenceType="undertalem:UndertaleFont" />

                                    <Label Content="{l:Loc Room_ScaleX}"/>
                                    <TextBox Text="{Binding ScaleX}" />

                                    <Label Content="{l:Loc Room_ScaleY}"/>
                                    <TextBox Text="{Binding ScaleY}" />

                                    <Label Content="{l:Loc Room_Rotation}"/>
                                    <TextBox Text="{Binding Rotation}" />

                                    <Label Content="{l:Loc Room_Color}"/>
                                    <ColorPicker Color="{Binding Color, Converter={StaticResource UndertaleColorToColorConverter}}" />

                                    <Label Content="{l:Loc Room_OriginX}"/>
                                    <TextBox Text="{Binding OriginX}" />

                                    <Label Content="{l:Loc Room_OriginY}"/>
                                    <TextBox Text="{Binding OriginY}" />

                                    <Label Content="{l:Loc Room_Text}"/>
                                    <l:UndertaleStringReferenceView Reference="{Binding Text}" />

                                    <Label Content="{l:Loc Room_Alignment}"/>
                                    <TextBox Text="{Binding Alignment}" />

                                    <Label Content="{l:Loc Room_CharSpacing}"/>
                                    <TextBox Text="{Binding CharSpacing}" />

                                    <Label Content="{l:Loc Room_LineSpacing}"/>
                                    <TextBox Text="{Binding LineSpacing}" />

                                    <Label Content="{l:Loc Room_FrameWidth}"/>
                                    <TextBox Text="{Binding FrameWidth}" />

                                    <Label Content="{l:Loc Room_FrameHeight}"/>
                                    <TextBox Text="{Binding FrameHeight}" />

                                    <Label Content="{l:Loc Room_Wrap}"/>
                                    <CheckBox IsChecked="{Binding Wrap}" />

                                    <Label Content="{l:Loc Room_ParagraphSpacing}"/>
                                    <TextBox Text="{Binding ParagraphSpacing}" />
                                    
                                    <Label Content="{l:Loc Room_WrapMode}"/>
                                    <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleSequence+TextKeyframes+WrapMode}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                              SelectedItem="{Binding WrapMode}" />

                                    <Label Content="{l:Loc Room_Origin}"/>
                                    <ComboBox ItemsSource="{Binding Source={x:Type undertalem:UndertaleSequence+TextKeyframes+Origin}, Converter={StaticResource EnumTypeToValuesConverter}}"
                                              SelectedItem="{Binding Origin}" />
                                </Grid>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter x:Name="SideSplitter" Grid.Column="1" />

        <!-- Editor column -->
        <Grid Grid.Column="2" RowDefinitions="Auto,1*,Auto">
            <!-- Top bar: overlay toggles on the left, function buttons (as icons) on the right -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,1*,Auto" Margin="0,0,0,4">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="TreeOverlayButton"
                                  Click="TreeOverlayButton_Click"
                                  ToolTip.Tip="Toggle tree view overlay"
                                  Padding="6,4">
                        <Panel Width="18" Height="18">
                            <Rectangle Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.5" RadiusX="2.5" RadiusY="2.5" />
                            <Line StartPoint="6.5,1" EndPoint="6.5,17" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.5" />
                        </Panel>
                    </ToggleButton>
                    <ToggleButton x:Name="PropertiesOverlayButton"
                                  Click="PropertiesOverlayButton_Click"
                                  ToolTip.Tip="Toggle properties overlay"
                                  Padding="6,4">
                        <Panel Width="18" Height="18">
                            <Line StartPoint="1,4.5" EndPoint="17,4.5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.5" />
                            <Line StartPoint="1,9" EndPoint="17,9" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.5" />
                            <Line StartPoint="1,13.5" EndPoint="17,13.5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.5" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Left" Margin="7.5,1.5,0,0" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Left" Margin="2.5,6,0,0" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Left" Margin="10,10.5,0,0" />
                        </Panel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Command="{Binding SaveAsImage}"
                            ToolTip.Tip="Save as image"
                            Padding="6,4">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              Data="M3,3 L13,3 L17,7 L17,17 L3,17 Z M5,3 L5,8 L12,8 L12,3 M5,10 L14,10 L14,17 L5,17 Z" />
                    </Button>
                    <ToggleButton IsChecked="{Binding IsLocked}"
                                  ToolTip.Tip="Lock"
                                  Padding="6,4">
                        <Panel Width="18" Height="18">
                            <Path Data="M6,8 L6,5 A3,3 0 0 1 12,5 L12,8"
                                  Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                  StrokeThickness="1.5" />
                            <Rectangle Width="12" Height="8" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.5"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                        </Panel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsSelectAnyLayerEnabled}"
                                  ToolTip.Tip="Select any layer"
                                  Padding="6,4">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.5"
                              Data="M9,2.5 L15.5,6 L9,9.5 L2.5,6 Z M2.5,9.75 L9,13.25 L15.5,9.75 M2.5,13.25 L9,16.75 L15.5,13.25" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsGridEnabled}"
                                  ToolTip.Tip="Grid"
                                  Padding="6,4">
                        <Panel Width="18" Height="18">
                            <Rectangle Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" />
                            <Line StartPoint="6.5,1" EndPoint="6.5,17" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1" />
                            <Line StartPoint="11.5,1" EndPoint="11.5,17" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1" />
                            <Line StartPoint="1,6.5" EndPoint="17,6.5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1" />
                            <Line StartPoint="1,11.5" EndPoint="17,11.5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1" />
                        </Panel>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!-- View + semi-transparent overlays -->
            <Panel Grid.Row="1">
                <l:UndertaleRoomEditor />

                <Border x:Name="TreeOverlayHost"
                        IsVisible="False"
                        HorizontalAlignment="Left"
                        Width="330"
                        Margin="8"
                        CornerRadius="8"
                        Padding="8"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        BoxShadow="0 4 16 0 #40000000"
                        Opacity="0.94"
                        ZIndex="10">
                    <Grid RowDefinitions="Auto,1*">
                        <Grid Grid.Row="0" ColumnDefinitions="1*,Auto" Margin="0,0,0,6">
                            <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="Tree view" />
                            <Button Grid.Column="1" Click="TreeOverlayClose_Click" Padding="6,0" Content="✕" />
                        </Grid>
                        <Border Grid.Row="1" x:Name="TreeOverlayContent" MinHeight="200" />
                    </Grid>
                </Border>

                <Border x:Name="PropertiesOverlayHost"
                        IsVisible="False"
                        HorizontalAlignment="Left"
                        Width="340"
                        Margin="8"
                        CornerRadius="8"
                        Padding="8"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        BoxShadow="0 4 16 0 #40000000"
                        Opacity="0.94"
                        ZIndex="11">
                    <Grid RowDefinitions="Auto,1*">
                        <Grid Grid.Row="0" ColumnDefinitions="1*,Auto" Margin="0,0,0,6">
                            <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="Properties" />
                            <Button Grid.Column="1" Click="PropertiesOverlayClose_Click" Padding="6,0" Content="✕" />
                        </Grid>
                        <Border Grid.Row="1" x:Name="PropertiesOverlayContent" MinHeight="200" />
                    </Grid>
                </Border>
            </Panel>

            <!-- Bottom bar: status text on the left, grid size and zoom slider on the right -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,1*,Auto" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBox Text="{Binding GridWidth}" Width="40" ToolTip.Tip="Grid width" />
                    <TextBox Text="{Binding GridHeight}" Width="40" ToolTip.Tip="Grid height" />
                    <!-- Logarithmic scale: slider center = 100% (range 5% .. 3200%), dragging snaps up to whole percents -->
                    <Slider Minimum="0" Maximum="1"
                            Value="{Binding Zoom, Converter={StaticResource ZoomLogConverter}}"
                            Width="140" VerticalAlignment="Center"
                            ToolTip.Tip="Zoom" />
                    <TextBlock Text="{Binding Zoom, Converter={StaticResource ZoomConverter}, Mode=OneWay}"
                               VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
