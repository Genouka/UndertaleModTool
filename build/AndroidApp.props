<!--
    Version and release-channel properties shared by the two Android APKs:

      * UndertaleModToolAvalonia.Android             - the real app ("normal APK").
      * UndertaleModToolAvalonia.AndroidPreinstall   - the Android 10 storage-permission helper
                                                       ("preinstall APK" / 前置 APK).

    Both APKs are built from the same workflow run and published side by side, and they have to
    agree on two things:

      * The application id, so the helper can be installed over the app and the app can be
        installed over the helper (same package = same app data, no uninstall in between).
      * The version code, so neither of those two installs is rejected as a downgrade.

    That second point is what makes the Android 10 flow work at all: the system only preserves the
    legacy external-storage model across an *update* of a package that already had it (see
    android:preserveLegacyExternalStorage), so the helper has to be installed first and the app
    installed directly on top of it - without uninstalling anything. Deriving the version code in
    one place is what keeps the two APKs in lockstep.

    The app side of this story lives in
    UndertaleModToolAvalonia.Android/AndroidStorageSetup.cs (download URL) and
    UndertaleModToolAvalonia.Android/StoragePermissionHelper.cs (detection/request).
-->
<Project>

    <PropertyGroup>
        <!--
            The APK version follows the main Avalonia project's <Version> so the two can never
            drift apart: the version the system installer reports for the app has to be the same
            version the app itself shows (App.VersionString is read from the
            UndertaleModToolAvalonia assembly, not from this one). MSBuild cannot read a property
            from a referenced project, so the value is picked straight out of that project file.
            Expected form: <major>.<minor>.<patch>[.<revision>].
        -->
        <_AvaloniaProjectFile>$(MSBuildThisFileDirectory)..\UndertaleModToolAvalonia\UndertaleModToolAvalonia.csproj</_AvaloniaProjectFile>
        <_AvaloniaProjectText>$([System.IO.File]::ReadAllText('$(_AvaloniaProjectFile)'))</_AvaloniaProjectText>
        <Version>$([System.Text.RegularExpressions.Regex]::Match($(_AvaloniaProjectText), '&lt;Version&gt;([0-9][0-9.]*)&lt;/Version&gt;').Groups[1].Value)</Version>
        <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>

        <!--
            Android's version code is a separate, monotonically increasing integer, derived from
            the same version as major * 1000000 + minor * 10000 + patch * 100 + revision
            (0.9.2.0 -> 90200), so it moves with every release instead of being bumped by hand.
            Each step is a property of its own: nested property-function calls are not reliably
            expanded - MSBuild leaves such an expression as literal text instead of failing.
        -->
        <_VerMajor>$([System.Version]::Parse('$(Version)').Major)</_VerMajor>
        <_VerMinor>$([System.Version]::Parse('$(Version)').Minor)</_VerMinor>
        <_VerPatch>$([System.Version]::Parse('$(Version)').Build)</_VerPatch>
        <_VerRevision>$([System.Version]::Parse('$(Version)').Revision)</_VerRevision>
        <!-- A version written with fewer than four parts leaves these at -1. -->
        <_VerPatch Condition="'$(_VerPatch)' == '-1'">0</_VerPatch>
        <_VerRevision Condition="'$(_VerRevision)' == '-1'">0</_VerRevision>
        <_AndroidCodeMajor>$([MSBuild]::Multiply($(_VerMajor), 1000000))</_AndroidCodeMajor>
        <_AndroidCodeMinor>$([MSBuild]::Multiply($(_VerMinor), 10000))</_AndroidCodeMinor>
        <_AndroidCodePatch>$([MSBuild]::Multiply($(_VerPatch), 100))</_AndroidCodePatch>
        <_AndroidCodeMajorMinor>$([MSBuild]::Add($(_AndroidCodeMajor), $(_AndroidCodeMinor)))</_AndroidCodeMajorMinor>
        <_AndroidCodePatchRevision>$([MSBuild]::Add($(_AndroidCodePatch), $(_VerRevision)))</_AndroidCodePatchRevision>
        <ApplicationVersion>$([MSBuild]::Add($(_AndroidCodeMajorMinor), $(_AndroidCodePatchRevision)))</ApplicationVersion>

        <!--
            Release channel this APK is published from: "nightly" (the default) or "stable". The
            stable release workflow passes -p:AndroidPreinstallChannel=stable; everything else
            (nightly, local builds) stays on nightly, which matches the release the app's own
            in-app updater already looks at. The channel decides nothing but the download link the
            app shows for the preinstall APK (see AndroidStorageSetup.cs): nightly assets live under
            the "nightly" tag, stable assets under "releases/latest" (the preinstall asset name
            carries no version precisely so the stable link does not depend on the release tag).
        -->
        <AndroidPreinstallChannel Condition="'$(AndroidPreinstallChannel)' == ''">nightly</AndroidPreinstallChannel>
        <DefineConstants Condition="'$(AndroidPreinstallChannel)' == 'stable'">$(DefineConstants);ANDROID_PREINSTALL_STABLE</DefineConstants>
    </PropertyGroup>

    <!--
        Fixed APK signing. When the UMT_ANDROID_KEYSTORE_PATH environment variable is set (the CI
        workflows do this after materialising the ANDROID_KEYSTORE_BASE64 repo secret into a file
        under $RUNNER_TEMP), both APKs are signed with that one fixed keystore - the app and the
        preinstall helper share one application id, so the system only accepts installing either
        of them over the other if both carry the same signature. MSBuild exposes environment
        variables as properties by themselves, so the workflows pass nothing on the dotnet command
        line and the secrets never get echoed.

        Without those variables (local development) this group is skipped and the build falls back
        to the auto-generated per-machine debug keystore, as before. Remember that a debug-signed
        APK can never install over a release-signed one (and vice versa) - uninstall in between.

        PKCS12 keystores (keytool's default) force the key password to equal the store password,
        so one secret covers both.
    -->
    <PropertyGroup Condition="'$(UMT_ANDROID_KEYSTORE_PATH)' != ''">
        <AndroidKeyStore>True</AndroidKeyStore>
        <AndroidSigningKeyStore>$(UMT_ANDROID_KEYSTORE_PATH)</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias Condition="'$(UMT_ANDROID_KEY_ALIAS)' != ''">$(UMT_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
        <AndroidSigningKeyAlias Condition="'$(UMT_ANDROID_KEY_ALIAS)' == ''">qiuutmtv5</AndroidSigningKeyAlias>
        <AndroidSigningStorePass>$(UMT_ANDROID_KEY_PASSWORD)</AndroidSigningStorePass>
        <AndroidSigningKeyPass>$(UMT_ANDROID_KEY_PASSWORD)</AndroidSigningKeyPass>
    </PropertyGroup>

</Project>
