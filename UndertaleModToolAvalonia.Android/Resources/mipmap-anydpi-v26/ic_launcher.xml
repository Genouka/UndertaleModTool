<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+; the app's minimum is 28, so this is the only definition
     needed). Foreground artwork sits inside the 66dp safe zone of the 108dp canvas - see
     mipmap-*/ic_launcher_foreground.png - so no launcher mask crops the wings. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
