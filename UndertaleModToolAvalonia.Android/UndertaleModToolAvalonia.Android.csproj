<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
        <AndroidUseFastDeployment>False</AndroidUseFastDeployment>

        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <!-- Compile against the real Avalonia assemblies so the simulated windowing platform
             (Avalonia.Platform.IWindowImpl etc.) and AvaloniaLocator.CurrentMutable are usable. -->
        <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
        <NoWarn>$(NoWarn);AVA3001</NoWarn>

        <!--
            The APK version follows the main Avalonia project's <Version> so the two can never
            drift apart: the version the system installer reports for the app has to be the same
            version the app itself shows (App.VersionString is read from the
            UndertaleModToolAvalonia assembly, not from this one). MSBuild cannot read a property
            from a referenced project, so the value is picked straight out of that project file.
            Expected form: <major>.<minor>.<patch>[.<revision>].
        -->
        <_AvaloniaProjectFile>$(MSBuildThisFileDirectory)..\UndertaleModToolAvalonia\UndertaleModToolAvalonia.csproj</_AvaloniaProjectFile>
        <_AvaloniaProjectText>$([System.IO.File]::ReadAllText('$(_AvaloniaProjectFile)'))</_AvaloniaProjectText>
        <Version>$([System.Text.RegularExpressions.Regex]::Match($(_AvaloniaProjectText), '&lt;Version&gt;([0-9][0-9.]*)&lt;/Version&gt;').Groups[1].Value)</Version>
        <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>

        <!--
            Android's version code is a separate, monotonically increasing integer, derived from
            the same version as major * 1000000 + minor * 10000 + patch * 100 + revision
            (0.9.2.0 -> 90200), so it moves with every release instead of being bumped by hand.
            Each step is a property of its own: nested property-function calls are not reliably
            expanded - MSBuild leaves such an expression as literal text instead of failing.
        -->
        <_VerMajor>$([System.Version]::Parse('$(Version)').Major)</_VerMajor>
        <_VerMinor>$([System.Version]::Parse('$(Version)').Minor)</_VerMinor>
        <_VerPatch>$([System.Version]::Parse('$(Version)').Build)</_VerPatch>
        <_VerRevision>$([System.Version]::Parse('$(Version)').Revision)</_VerRevision>
        <!-- A version written with fewer than four parts leaves these at -1. -->
        <_VerPatch Condition="'$(_VerPatch)' == '-1'">0</_VerPatch>
        <_VerRevision Condition="'$(_VerRevision)' == '-1'">0</_VerRevision>
        <_AndroidCodeMajor>$([MSBuild]::Multiply($(_VerMajor), 1000000))</_AndroidCodeMajor>
        <_AndroidCodeMinor>$([MSBuild]::Multiply($(_VerMinor), 10000))</_AndroidCodeMinor>
        <_AndroidCodePatch>$([MSBuild]::Multiply($(_VerPatch), 100))</_AndroidCodePatch>
        <_AndroidCodeMajorMinor>$([MSBuild]::Add($(_AndroidCodeMajor), $(_AndroidCodeMinor)))</_AndroidCodeMajorMinor>
        <_AndroidCodePatchRevision>$([MSBuild]::Add($(_AndroidCodePatch), $(_VerRevision)))</_AndroidCodePatchRevision>
        <ApplicationVersion>$([MSBuild]::Add($(_AndroidCodeMajorMinor), $(_AndroidCodePatchRevision)))</ApplicationVersion>

        <ApplicationId>com.undertalemodtool.avalonia.android</ApplicationId>
        <ApplicationTitle>QiuUTMTv5</ApplicationTitle>

        <AndroidUseAapt2>true</AndroidUseAapt2>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <RunAOTCompilation>false</RunAOTCompilation>
        <EnableLLVM>false</EnableLLVM>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="12.1.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
        <PackageReference Include="Magick.NET.Core" Version="14.16.0" />
        <!-- Android 版 Magick 原生包：arm64 / x64 都引用，打包时按当前 ABI 只打进对应的 .so -->
        <PackageReference Include="Magick.NET-Q8-arm64" Version="14.16.0" />
        <PackageReference Include="Magick.NET-Q8-x64" Version="14.16.0" />
        <!-- 安全网：共享项目会把桌面包 Magick.NET-Q8-AnyCPU 传递进来，这里显式排除其 runtimes，
             确保 linux-* 的 .so 永远不会混进 Android APK -->
        <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" ExcludeAssets="runtimes;native" />
        <PackageReference Include="SDL3-CS.Android" Version="3.4.14.1" />
        <PackageReference Include="SDL3-CS.Android.Mixer" Version="3.2.4.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\UndertaleModToolAvalonia\UndertaleModToolAvalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AndroidResource Include="Resources\values\colors.xml" />
        <AndroidResource Include="Resources\values\styles.xml" />
        <AndroidResource Include="Resources\values-night\colors.xml" />
        <AndroidResource Include="Resources\values-night\styles.xml" />
        <AndroidResource Include="Resources\xml\file_paths.xml" />
    </ItemGroup>

    <!--
        Android script support: the Roslyn scripting engine (Core/Scripting.cs) resolves metadata
        references from real files, but on Android the managed (non-AOT) assemblies are stored
        inside the APK (assembly store / lib/*.dll.so) and cannot be resolved from the filesystem,
        so script compilation fails with "cannot find assembly". To fix that, package plain DLL
        copies of every resolved managed assembly under assets/ScriptAssemblies; at runtime
        ScriptAssemblyExtractor extracts them to internal storage and Scripting.RunScript uses that
        folder as the script compilation references.

        Source of the DLLs: the unshrunk (and non-AOT) per-ABI assembly copies produced by
        _LinkAssembliesNoShrink into $(MonoAndroidIntermediateAssemblyDir)<abi>\. Only the first
        supported ABI is packaged - the managed assemblies are identical across ABIs.
        Hooked before _ComputeAndroidAssetsPaths (the target inside UpdateAndroidAssets that consumes
        @(AndroidAsset)), so the new asset entries always reach the aapt2 packaging regardless of
        incremental build state. Note: hooking UpdateAndroidAssets itself is too late - a target's
        DependsOnTargets run before BeforeTargets hooks.
    -->
    <Target Name="BundleScriptAssembliesToAssets"
            DependsOnTargets="_LinkAssembliesNoShrink;_ResolveAndroidTooling"
            BeforeTargets="_ComputeAndroidAssetsPaths"
            Condition="'$(EmbedAssembliesIntoApk)' == 'True'">
        <PropertyGroup>
            <_ScriptAssembliesAbi>$(AndroidSupportedAbis.Split(';')[0])</_ScriptAssembliesAbi>
            <_ScriptAssembliesDir>$(MonoAndroidIntermediateAssemblyDir)$(_ScriptAssembliesAbi)</_ScriptAssembliesDir>
        </PropertyGroup>
        <ItemGroup Condition="'$(_ScriptAssembliesAbi)' != '' And Exists('$(_ScriptAssembliesDir)')">
            <!-- Two-step item construction: well-known metadata (%(Filename)/%(Extension)) of glob
                 items is not yet computed when other metadata on the SAME ItemGroup entry is
                 evaluated, so Link would end up empty. Reading them via %(_ScriptDll.Filename)
                 in a second ItemGroup yields the real value. Link must carry the "Assets\" prefix:
                 AndroidComputeResPaths strips it and keeps the remainder as the asset path inside
                 assets/ScriptAssemblies/. -->
            <_ScriptDll Include="$(_ScriptAssembliesDir)\*.dll" />
        </ItemGroup>
        <ItemGroup Condition="'$(_ScriptAssembliesAbi)' != '' And Exists('$(_ScriptAssembliesDir)')">
            <AndroidAsset Include="@(_ScriptDll)"
                          Link="Assets\ScriptAssemblies\%(_ScriptDll.Filename)%(_ScriptDll.Extension)" />
        </ItemGroup>
    </Target>

    <!--
        Built-in utility scripts (the Scripts folder shared with the WPF UndertaleModTool project),
        packaged under assets/Scripts with their folder structure preserved. At runtime
        BuiltInScriptExtractor copies them into internal storage and points the BuiltInScripts menu
        at that copy - there is no executable directory to read from on Android.

        Hooked before _ComputeAndroidAssetsPaths like BundleScriptAssembliesToAssets, so the asset
        entries always reach the aapt2 packaging. The transform runs inside a target because
        well-known metadata (%(RecursiveDir)/%(Filename)) of glob items only expands there.
    -->
    <Target Name="BundleBuiltInScriptsToAssets" BeforeTargets="_ComputeAndroidAssetsPaths">
        <ItemGroup>
            <_BuiltInCsx Include="..\UndertaleModTool\Scripts\**\*.csx" />
        </ItemGroup>
        <ItemGroup Condition="'@(_BuiltInCsx)' != ''">
            <AndroidAsset Include="@(_BuiltInCsx)"
                          Link="Assets\Scripts\%(_BuiltInCsx.RecursiveDir)%(_BuiltInCsx.Filename)%(_BuiltInCsx.Extension)" />
        </ItemGroup>
    </Target>

</Project>