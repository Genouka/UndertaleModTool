<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Shared with UndertaleModToolAvalonia.AndroidPreinstall: the app version, the Android version
        code (both APKs must carry the same one, see the file for why) and the release channel.
    -->
    <Import Project="..\build\AndroidApp.props" />

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
        <AndroidUseFastDeployment>False</AndroidUseFastDeployment>

        <!-- Local builds target the phone ABI by default. CI passes -r per matrix entry; pass
             -p:RuntimeIdentifiers="android-arm64;android-x64" for a universal local APK. -->
        <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == '' and '$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifiers>
        <!-- Only the sideloaded APK is shipped; generating an AAB as well doubles packaging time. -->
        <AndroidPackageFormats>apk</AndroidPackageFormats>

        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <!-- Compile against the real Avalonia assemblies so the simulated windowing platform
             (Avalonia.Platform.IWindowImpl etc.) and AvaloniaLocator.CurrentMutable are usable. -->
        <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
        <NoWarn>$(NoWarn);AVA3001</NoWarn>

        <ApplicationId>com.undertalemodtool.avalonia.android</ApplicationId>
        <ApplicationTitle>QiuUTMTv5</ApplicationTitle>

        <AndroidUseAapt2>true</AndroidUseAapt2>
        <!--
            Mono AOT is enabled for Release only: Debug stays JIT/interpreter so the edit-build
            loop is not paying for AOT. Profiled AOT (the SDK default profile) compiles the hot
            code paths instead of every method, which is what keeps the Release build short; pass
            -p:AndroidEnableProfiledAot=false for a full AOT build.
            ILLink + AOT peak around several GB of RAM; on laptops with little free memory append
            -m:1 to the dotnet publish command to keep the build below that peak.
            Do not switch to NativeAOT: the script engine compiles C# at runtime, which requires
            the Mono JIT. Release uses JIT for those dynamic assemblies regardless of AOT.
        -->
        <RunAOTCompilation>false</RunAOTCompilation>
        <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
        <AndroidEnableProfiledAot Condition="'$(RunAOTCompilation)' == 'true'">true</AndroidEnableProfiledAot>
        <UseInterpreter Condition="'$(RunAOTCompilation)' == 'true'">false</UseInterpreter>
        <EnableLLVM>false</EnableLLVM>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="12.1.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
        <PackageReference Include="Magick.NET.Core" Version="14.16.0" />
        <!-- Android 版 Magick 原生包：arm64 / x64 都引用，打包时按当前 ABI 只打进对应的 .so -->
        <PackageReference Include="Magick.NET-Q8-arm64" Version="14.16.0" />
        <PackageReference Include="Magick.NET-Q8-x64" Version="14.16.0" />
        <!-- 安全网：共享项目会把桌面包 Magick.NET-Q8-AnyCPU 传递进来，这里显式排除其 runtimes，
             确保 linux-* 的 .so 永远不会混进 Android APK -->
        <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" ExcludeAssets="runtimes;native" />
        <!-- The AAR already carries the same jni/<abi>/libSDL3.so files under lib/, so the
             runtimes/<rid>/native copies only produce a duplicate-entry warning (XA4301) while
             packing. Exclude the redundant native assets and let the AAR provide the library. -->
        <PackageReference Include="SDL3-CS.Android" Version="3.4.14.1" ExcludeAssets="native" />
        <PackageReference Include="SDL3-CS.Android.Mixer" Version="3.2.4.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\UndertaleModToolAvalonia\UndertaleModToolAvalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AndroidResource Include="Resources\values\colors.xml" />
        <AndroidResource Include="Resources\values\styles.xml" />
        <AndroidResource Include="Resources\values\strings.xml" />
        <AndroidResource Include="Resources\values-night\colors.xml" />
        <AndroidResource Include="Resources\values-night\styles.xml" />
        <AndroidResource Include="Resources\xml\file_paths.xml" />
        <!-- Adaptive launcher icon (see mipmap-anydpi-v26\ic_launcher.xml): the density PNGs are
             explicit because the rest of this project lists resources explicitly as well. -->
        <AndroidResource Include="Resources\mipmap-anydpi-v26\ic_launcher.xml" />
        <AndroidResource Include="Resources\mipmap-mdpi\*.png" />
        <AndroidResource Include="Resources\mipmap-hdpi\*.png" />
        <AndroidResource Include="Resources\mipmap-xhdpi\*.png" />
        <AndroidResource Include="Resources\mipmap-xxhdpi\*.png" />
        <AndroidResource Include="Resources\mipmap-xxxhdpi\*.png" />
    </ItemGroup>

    <!--
        Cross-app API: the AIDL contract other apps bind against (see Api/README.md). The contract
        itself lives in the SDK repository, which the "api" git submodule points at, because its
        clients compile the very same file - one copy means the tool and its clients cannot drift
        apart. Initialise the submodule (api/) before building this project.

        The "AndroidInterfaceDescription" build action makes the .NET Android build run the managed
        AIDL generator, which emits the C# IUmApi interface + IUmApiStub binder into
        obj/<config>/<tfm>/aidl/ and adds them to the compilation, so the service can implement the
        contract in C#.
    -->
    <ItemGroup>
        <AndroidInterfaceDescription Include="..\api\umapi\src\main\aidl\com\undertalemodtool\avalonia\android\api\IUmApi.aidl" />
    </ItemGroup>

    <PropertyGroup>
        <!--
            The managed AIDL proxies (obj/<config>/<tfm>/aidl/*.cs, generated from the submodule's
            api/umapi/src/main/aidl/.../IUmApi.aidl) are nullable-oblivious: they declare each parcel
            argument as a non-nullable local, assign what they read back to it, and cast the
            replies. Compiling that generated file with nullable analysis on reports dozens of CS86xx
            warnings that the generator cannot fix, so those four codes are silenced for the
            project.
        -->
        <NoWarn>$(NoWarn);CS8600;CS8603;CS8604;CS8765</NoWarn>
    </PropertyGroup>

    <!--
        The managed AIDL generator in the .NET Android SDK still emits calls to the obsolete
        Android.OS.BinderConsts API. The generated file cannot be edited and the generator has no
        option to emit the replacement, so prepend a pragma to the generated proxy. This keeps
        CS0618 enabled for the project's own source, where a deprecation must stay visible.
    -->
    <Target Name="SuppressObsoleteWarningsInGeneratedAidl"
            AfterTargets="_RunManagedAidlTool"
            Condition="Exists('$(IntermediateOutputPath)aidl\IUmApi.cs')">
        <ReadLinesFromFile File="$(IntermediateOutputPath)aidl\IUmApi.cs">
            <Output TaskParameter="Lines" ItemName="_GeneratedAidlLines" />
        </ReadLinesFromFile>
        <!-- Idempotent: drop a pragma left by a previous run before prepending it again. -->
        <ItemGroup>
            <_GeneratedAidlLines Remove="@(_GeneratedAidlLines)" Condition="'%(_GeneratedAidlLines.Identity)' == '#pragma warning disable CS0618'" />
        </ItemGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)aidl\IUmApi.cs"
                          Lines="#pragma warning disable CS0618;@(_GeneratedAidlLines)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
    </Target>

    <!--
        Android script support: the Roslyn scripting engine (Core/Scripting.cs) resolves metadata
        references from real files, but on Android the managed (non-AOT) assemblies are stored
        inside the APK (assembly store / lib/*.dll.so) and cannot be resolved from the filesystem,
        so script compilation fails with "cannot find assembly". To fix that, package plain DLL
        copies of every resolved managed assembly under assets/ScriptAssemblies; at runtime
        ScriptAssemblyExtractor extracts them to internal storage and Scripting.RunScript uses that
        folder as the script compilation references.

        Source of the DLLs:
        - untrimmed Debug: the copies produced by _LinkAssembliesNoShrink into
          $(MonoAndroidIntermediateAssemblyDir)<abi>\;
        - trimmed/AOT Release: the ILLink output (@(_ShrunkAssemblies), linked\shrunk\). The
          script-reference assemblies are rooted for ILLink (see RootScriptReferenceAssemblies),
          so they contain their full API surface in both configurations.
        Only the first supported ABI is packaged - the managed assemblies are identical across
        ABIs. Only script-reference candidates are packaged (same prefixes as
        ScriptReferencePrefixes in Core/Scripting.cs); the rest are never handed to the compiler and
        only inflated the APK and its extraction time.

        Hooked before _ComputeAndroidAssetsPaths (the target inside UpdateAndroidAssets that consumes
        @(AndroidAsset)), so the new asset entries always reach the aapt2 packaging regardless of
        incremental build state. Note: hooking UpdateAndroidAssets itself is too late - a target's
        DependsOnTargets run before BeforeTargets hooks.

        _RemoveRegisterAttribute is a dependency because it is what creates the linked\shrunk copies
        on a trimmed build. The AOT publish path can reach _CreateBaseApk without having run it, and
        the asset pipeline would then fail on the missing source files (XA2001).
    -->
    <Target Name="BundleScriptAssembliesToAssets"
            DependsOnTargets="_LinkAssembliesNoShrink;_RemoveRegisterAttribute;_ResolveAndroidTooling"
            BeforeTargets="_ComputeAndroidAssetsPaths"
            Condition="'$(EmbedAssembliesIntoApk)' == 'True'">
        <PropertyGroup>
            <_ScriptAssembliesAbi>$(AndroidSupportedAbis.Split(';')[0])</_ScriptAssembliesAbi>
            <_ScriptAssembliesDir Condition="'$(PublishTrimmed)' != 'true'">$(MonoAndroidIntermediateAssemblyDir)$(_ScriptAssembliesAbi)</_ScriptAssembliesDir>
        </PropertyGroup>
        <ItemGroup>
            <_ScriptDll Condition="'$(PublishTrimmed)' != 'true' And '$(_ScriptAssembliesAbi)' != '' And Exists('$(_ScriptAssembliesDir)')"
                        Include="$(_ScriptAssembliesDir)\*.dll" />
            <!-- A universal (multi-ABI) publish has one copy per ABI; package the first ABI only,
                 like the untrimmed path above. DestinationSubPath starts with the ABI name. -->
            <_ScriptDll Condition="'$(PublishTrimmed)' == 'true' And '$(_ScriptAssembliesAbi)' != '' And $([System.String]::Copy('%(_ShrunkAssemblies.DestinationSubPath)').StartsWith('$(_ScriptAssembliesAbi)'))"
                        Include="@(_ShrunkAssemblies)" />
        </ItemGroup>
        <Error Condition="'$(PublishTrimmed)' == 'true' And '@(_ScriptDll)' == ''"
               Text="BundleScriptAssembliesToAssets: no trimmed assemblies were found. _PrepareAssemblies must run before _ComputeAndroidAssetsPaths." />
        <ItemGroup>
            <!-- Two-step item construction: well-known metadata (%(Filename)/%(Extension)) of glob
                 items is not yet computed when other metadata on the SAME ItemGroup entry is
                 evaluated, so Link would end up empty. Reading them via %(_ScriptDll.Filename)
                 in a second ItemGroup yields the real value. Link must carry the "Assets\" prefix:
                 AndroidComputeResPaths strips it and keeps the remainder as the asset path inside
                 assets/ScriptAssemblies/.
                 Keep the prefix list in sync with ScriptReferencePrefixes in Core/Scripting.cs. -->
            <_ScriptDllFiltered Include="@(_ScriptDll)"
                                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_ScriptDll.Filename)', '(?i)^(System|mscorlib|netstandard|Microsoft\.CSharp|UndertaleModLib|Underanalyzer|UndertaleModToolAvalonia|UndertaleModToolLocalization|Magick\.NET\.Core|Magick\.NET-Q8-AnyCPU|ICSharpCode\.SharpZipLib|Newtonsoft)(\..*)?$'))" />
        </ItemGroup>
        <ItemGroup>
            <AndroidAsset Include="@(_ScriptDllFiltered)"
                          Link="Assets\ScriptAssemblies\%(_ScriptDllFiltered.Filename)%(_ScriptDllFiltered.Extension)" />
        </ItemGroup>
    </Target>

    <!--
        Roslyn compiles arbitrary user scripts at runtime, so a trimmed reference set breaks even
        trivial scripts: Roslyn's generated async submission code calls
        AsyncTaskMethodBuilder<T>.AwaitOnCompleted, which the app itself never uses. The full
        API surface of every non-framework reference (UndertaleModLib, Underanalyzer, ...) is also
        part of the scripting contract. Root those assemblies for ILLink, so the compiler sees -
        and the AOT runtime can execute - their complete API, as in an untrimmed Debug build.

        Rooting every System.* library (root-all) OOMs ILLink on a 16 GB machine, so the framework
        set keeps the default reachability trimming; the packaged reference DLLs stay usable because
        the only framework members Roslyn's submissions invoke beyond app-reachable ones are in the
        reflection/async/linq core paths that the scripting engine itself references.

        System.Private.CoreLib is an implementation assembly (not part of ReferencePath), so it is
        rooted by name - its namespace prefix would otherwise match the System.* regex anyway.
        Keep the prefix list in sync with ScriptReferencePrefixes in Core/Scripting.cs.
    -->
    <Target Name="RootScriptReferenceAssemblies"
            BeforeTargets="_RunILLink"
            Condition="'$(PublishTrimmed)' == 'true' And '$(EmbedAssembliesIntoApk)' == 'True'">
        <ItemGroup>
            <TrimmerRootAssembly Include="@(ManagedAssemblyToLink->'%(Filename)')"
                                 Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '(?i)^(System\.Private\.CoreLib|mscorlib|netstandard|Microsoft\.CSharp|UndertaleModLib|Underanalyzer|UndertaleModToolAvalonia|UndertaleModToolLocalization|Magick\.NET\.Core|Magick\.NET-Q8-AnyCPU|ICSharpCode\.SharpZipLib|Newtonsoft)(\..*)?$'))"
                                 RootMode="All" />
        </ItemGroup>
    </Target>

    <!--
        Built-in utility scripts (the Scripts folder shared with the WPF UndertaleModTool project),
        packaged under assets/Scripts with their folder structure preserved. At runtime
        BuiltInScriptExtractor copies them into internal storage and points the BuiltInScripts menu
        at that copy - there is no executable directory to read from on Android.

        Hooked before _ComputeAndroidAssetsPaths like BundleScriptAssembliesToAssets, so the asset
        entries always reach the aapt2 packaging. The transform runs inside a target because
        well-known metadata (%(RecursiveDir)/%(Filename)) of glob items only expands there.
    -->
    <Target Name="BundleBuiltInScriptsToAssets" BeforeTargets="_ComputeAndroidAssetsPaths">
        <ItemGroup>
            <_BuiltInCsx Include="..\UndertaleModTool\Scripts\**\*.csx" />
        </ItemGroup>
        <ItemGroup Condition="'@(_BuiltInCsx)' != ''">
            <AndroidAsset Include="@(_BuiltInCsx)"
                          Link="Assets\Scripts\%(_BuiltInCsx.RecursiveDir)%(_BuiltInCsx.Filename)%(_BuiltInCsx.Extension)" />
        </ItemGroup>
    </Target>

</Project>